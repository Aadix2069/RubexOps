<Page x:Class="RubexOps.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <!-- ================================================= -->
        <!-- MAIN CONTAINER -->
        <!-- ================================================= -->

        <Grid Margin="24">

            <!-- ================================================= -->
            <!-- WATERMARK -->
            <!-- ================================================= -->

            <Image Source="Images/Rubex_logo.png"
                   Width="500"
                   Height="500"
                   Opacity="0.15"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Panel.ZIndex="0"/>


            <!-- ================================================= -->
            <!-- MAIN CONTENT -->
            <!-- ================================================= -->

            <Grid Panel.ZIndex="1">

                <!-- ================================================= -->
                <!-- PAGE STRUCTURE -->
                <!-- ================================================= -->

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <!-- ICON -->

                    <Border Width="64"
                            Height="64"
                            CornerRadius="32"
                            Background="#AAFFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.12"/>
                        </Border.Effect>

                        <materialDesign:PackIcon Kind="DatabaseCog"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="#0B8A8F"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>



                    <!-- TITLE -->

                    <StackPanel Grid.Column="1"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Database Settings"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <Border Width="220"
                                Height="4"
                                Background="#F59E42"
                                CornerRadius="2"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>



                <!-- ================================================= -->
                <!-- MAIN GLASS CARD -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        CornerRadius="30"
                        Padding="35"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="35"
                                          ShadowDepth="0"
                                          Opacity="0.16"/>
                    </Border.Effect>

                    <Grid>

                        <!-- INNER GLASS LAYER -->

                        <Border CornerRadius="26"
                                Background="#30FFFFFF"
                                Margin="-16"/>

                        <StackPanel>

                            <!-- ================================================= -->
                            <!-- SECTION TITLE -->
                            <!-- ================================================= -->

                            <TextBlock Text="Select Master Database File"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"
                                       Margin="0,0,0,30"/>



                            <!-- ================================================= -->
                            <!-- DATABASE PATH -->
                            <!-- ================================================= -->

                            <TextBlock Text="Database File Path"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12"/>



                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="170"/>

                                </Grid.ColumnDefinitions>



                                <!-- PATH BOX -->

                                <Border Grid.Column="0"
                                        Background="#70FFFFFF"
                                        BorderBrush="#99FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14">

                                    <TextBox x:Name="DatabasePathBox"
                                             Height="48"
                                             FontSize="15"
                                             Padding="14,5"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#111827"
                                             IsReadOnly="True"/>
                                </Border>



                                <!-- BROWSE BUTTON -->

                                <Button Grid.Column="2"
                                        Height="48"
                                        Background="#0EA5A8"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BrowseDatabase_Click">

                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0.18"/>
                                    </Button.Effect>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <materialDesign:PackIcon Kind="FolderSearch"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0"/>

                                        <TextBlock Text="Browse"/>
                                    </StackPanel>
                                </Button>
                            </Grid>



                            <!-- ================================================= -->
                            <!-- INFO CARD -->
                            <!-- ================================================= -->

                            <Border Background="#60EFF6FF"
                                    BorderBrush="#90BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18"
                                    Margin="0,30,0,0">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="0"
                                                      Opacity="0.08"/>
                                </Border.Effect>

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="InformationOutline"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="#2563EB"
                                                             Margin="0,0,12,0"/>

                                    <TextBlock Width="700"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="#1E3A8A"
                                               LineHeight="22">

                                        Select the masterdata.xlsx database file used by the system.
                                        This path will automatically be used across all contract
                                        creation, editing, renewal, termination, and analytics modules.
                                    </TextBlock>
                                </StackPanel>
                            </Border>



                            <!-- ================================================= -->
                            <!-- SAVE BUTTON -->
                            <!-- ================================================= -->

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,40,0,0">

                                <Button Width="200"
                                        Height="52"
                                        Background="#0EA5A8"
                                        Foreground="White"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="SaveSettings_Click">

                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0.18"/>
                                    </Button.Effect>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <materialDesign:PackIcon Kind="ContentSave"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,10,0"/>

                                        <TextBlock Text="Save Settings"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>