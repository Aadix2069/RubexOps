<Page x:Class="RubexOps.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Grid Margin="24">

        <!-- ================================================= -->
        <!-- PAGE STRUCTURE -->
        <!-- ================================================= -->

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- ICON -->

            <Border Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#E7F6F7">

                <materialDesign:PackIcon Kind="DatabaseCog"
                                         Width="30"
                                         Height="30"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>



            <!-- TITLE -->

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="Database Settings"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <Border Width="220"
                        Height="4"
                        Background="#F59E42"
                        CornerRadius="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>



        <!-- ================================================= -->
        <!-- MAIN CARD -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="35">

            <StackPanel>

                <!-- ================================================= -->
                <!-- SECTION TITLE -->
                <!-- ================================================= -->

                <TextBlock Text="Select Master Database File"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0B8A8F"
                           Margin="0,0,0,30"/>



                <!-- ================================================= -->
                <!-- DATABASE PATH -->
                <!-- ================================================= -->

                <TextBlock Text="Database File Path"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           Margin="0,0,0,12"/>



                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="170"/>

                    </Grid.ColumnDefinitions>



                    <!-- PATH BOX -->

                    <TextBox x:Name="DatabasePathBox"
                             Grid.Column="0"
                             Height="48"
                             FontSize="15"
                             Padding="14,5"
                             VerticalContentAlignment="Center"
                             Background="#F9FAFB"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1.5"
                             IsReadOnly="True"/>



                    <!-- BROWSE BUTTON -->

                    <Button Grid.Column="2"
                            Height="48"
                            Background="#0EA5A8"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BrowseDatabase_Click">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <materialDesign:PackIcon Kind="FolderSearch"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,8,0"/>

                            <TextBlock Text="Browse"/>
                        </StackPanel>
                    </Button>
                </Grid>



                <!-- ================================================= -->
                <!-- INFO CARD -->
                <!-- ================================================= -->

                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,30,0,0">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="InformationOutline"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#2563EB"
                                                 Margin="0,0,12,0"/>

                        <TextBlock Width="700"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="#1E3A8A"
                                   LineHeight="22">

                            Select the masterdata.xlsx database file used by the system.
                            This path will automatically be used across all contract
                            creation, editing, renewal, termination, and analytics modules.
                        </TextBlock>
                    </StackPanel>
                </Border>



                <!-- ================================================= -->
                <!-- SAVE BUTTON -->
                <!-- ================================================= -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,40,0,0">

                    <Button Width="200"
                            Height="52"
                            Background="#0EA5A8"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SaveSettings_Click">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <materialDesign:PackIcon Kind="ContentSave"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,10,0"/>

                            <TextBlock Text="Save Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>