<Window x:Class="RubexOps.RenewContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Renew Contract"
        Height="780"
        Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7F8">

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="58" Height="58" CornerRadius="29" Background="#E7F6F7">
                <materialDesign:PackIcon Kind="Refresh"
                                         Width="28"
                                         Height="28"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Renew Purchase Contract"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Create a new contract row while preserving the old contract history"
                           FontSize="14"
                           Margin="0,4,0,0"
                           Foreground="#6B7280"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="30">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Select Contract"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Contract"
                                   Grid.Row="0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Vendor Name"
                                   Grid.Row="1"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Vendor ID"
                                   Grid.Row="2"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Current Status"
                                   Grid.Row="3"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="ContractComboBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Height="48"
                                  FontSize="15"
                                  Padding="12,0"
                                  DisplayMemberPath="RenewDisplay"
                                  SelectionChanged="ContractComboBox_SelectionChanged"/>

                        <TextBox x:Name="VendorNameBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="48"
                                 FontSize="15"
                                 Padding="14,5"
                                 IsReadOnly="True"
                                 Background="#F3F4F6"/>

                        <TextBox x:Name="VendorIDBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Height="48"
                                 FontSize="15"
                                 Padding="14,5"
                                 IsReadOnly="True"
                                 Background="#F3F4F6"/>

                        <TextBox x:Name="StatusBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Height="48"
                                 FontSize="15"
                                 Padding="14,5"
                                 IsReadOnly="True"
                                 Background="#F3F4F6"/>
                    </Grid>

                    <TextBlock Text="New Contract Details"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,42,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="New Start Date *" Grid.Row="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="New End Date *" Grid.Row="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Base Price *" Grid.Row="2" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Agreed Quantity *" Grid.Row="3" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Penalty Percentage" Grid.Row="4" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Remedy Days" Grid.Row="5" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <DatePicker x:Name="StartDatePicker" Grid.Row="0" Grid.Column="1" Height="48" FontSize="15"/>
                        <DatePicker x:Name="EndDatePicker" Grid.Row="1" Grid.Column="1" Height="48" FontSize="15"/>

                        <TextBox x:Name="BasePriceBox" Grid.Row="2" Grid.Column="1" Height="48" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="AgreedQtyBox" Grid.Row="3" Grid.Column="1" Height="48" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="PenaltyPercentBox" Grid.Row="4" Grid.Column="1" Height="48" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="RemedyDaysBox" Grid.Row="5" Grid.Column="1" Height="48" FontSize="15" Padding="14,5"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="140"
                    Height="50"
                    Margin="0,0,16,0"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    FontSize="15"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="CancelButton_Click"/>

            <Button x:Name="RenewButton"
                    Content="Renew Contract"
                    Width="190"
                    Height="50"
                    Background="#0EA5A8"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="RenewButton_Click"/>
        </StackPanel>
    </Grid>
</Window>