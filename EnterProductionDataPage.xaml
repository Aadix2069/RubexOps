<Page x:Class="RubexOps.EnterProductionDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <StackPanel Orientation="Horizontal">
            <Border Width="68"
                    Height="68"
                    CornerRadius="34"
                    Background="#E7F6F7">
                <materialDesign:PackIcon Kind="Factory"
                                         Width="32"
                                         Height="32"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Enter Production Data"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Batch processing, stock consumption, DRC and production loss tracking"
                           FontSize="15"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ================================================= -->
                <!-- LIVE METRICS -->
                <!-- ================================================= -->

                <UniformGrid Columns="4" Margin="0,0,0,22">
                    <Border Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="18" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Batch ID" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="BatchIdMetricText" Text="BATCH-0001" FontSize="24" FontWeight="Bold" Foreground="#0B8A8F" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="18" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Remaining Quantity" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="RemainingMetricText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="18" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Production Loss" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="LossMetricText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="DRC Variance" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="VarianceMetricText" Text="0%" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================================================= -->
                    <!-- BATCH + SOURCE PANEL -->
                    <!-- ================================================= -->

                    <Border Background="White" CornerRadius="18" BorderBrush="#E5E7EB" BorderThickness="1" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Batch Information"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"
                                       Margin="0,0,0,24"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Batch ID" Grid.Row="0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Production Date" Grid.Row="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Source Search" Grid.Row="2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Supplier Name" Grid.Row="3" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Supplier ID" Grid.Row="4" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Invoice Number" Grid.Row="5" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox x:Name="BatchIdBox" Grid.Row="0" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                                <DatePicker x:Name="ProductionDatePicker" Grid.Row="1" Grid.Column="1" Height="48" FontSize="15"/>

                                <Grid Grid.Row="2" Grid.Column="1">
                                    <TextBox x:Name="SourceSearchBox" Height="46" FontSize="15" Padding="14,5" TextChanged="SourceSearchBox_TextChanged"/>
                                    <Popup x:Name="SourceSuggestionPopup"
                                           PlacementTarget="{Binding ElementName=SourceSearchBox}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           Width="{Binding ActualWidth, ElementName=SourceSearchBox}">
                                        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="240">
                                            <ListBox x:Name="SourceSuggestionList" BorderThickness="0" SelectionChanged="SourceSuggestionList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="10,8">
                                                            <TextBlock Text="{Binding SupplierName}" FontSize="15" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SourceDisplay}" FontSize="13" Foreground="#6B7280" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding AvailableDisplay}" FontSize="13" Foreground="#0B8A8F" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <TextBox x:Name="SupplierNameBox" Grid.Row="3" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                                <TextBox x:Name="SupplierIDBox" Grid.Row="4" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                                <TextBox x:Name="InvoiceNumberBox" Grid.Row="5" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ================================================= -->
                    <!-- MATERIAL FLOW PANEL -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2" Background="White" CornerRadius="18" BorderBrush="#E5E7EB" BorderThickness="1" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Material Flow"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"
                                       Margin="0,0,0,24"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                    <RowDefinition Height="68"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Raw Material" Grid.Row="0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Finished Product" Grid.Row="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Quantity Available" Grid.Row="2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Input Weight" Grid.Row="3" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Output Weight" Grid.Row="4" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Initial / Actual DRC" Grid.Row="5" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBox x:Name="RawMaterialBox" Grid.Row="0" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                                <TextBox x:Name="RawMaterialCodeBox" Grid.Row="0" Grid.Column="3" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>

                                <TextBox x:Name="FinishedProductBox" Grid.Row="1" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" Text="Processed Rubber"/>
                                <TextBox x:Name="FinishedProductCodeBox" Grid.Row="1" Grid.Column="3" Height="46" FontSize="15" Padding="14,5" Text="PRD"/>

                                <TextBox x:Name="QuantityAvailableBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>

                                <TextBox x:Name="InputWeightBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>
                                <TextBox x:Name="OutputWeightBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>

                                <TextBox x:Name="InitialDrcBox" Grid.Row="5" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>
                                <TextBox x:Name="ActualDrcBox" Grid.Row="5" Grid.Column="3" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>
                            </Grid>

                            <TextBlock Text="Production Analytics"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"
                                       Margin="0,34,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#F9FAFB" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Remaining Quantity" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="RemainingQuantityBox" Text="0" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F9FAFB" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Production Loss" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="ProductionLossBox" Text="0" FontSize="22" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#F9FAFB" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="DRC Variance" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="DrcVarianceBox" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================================================= -->
                <!-- ACTIONS -->
                <!-- ================================================= -->

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                    <Button Content="Clear Form"
                            Width="160"
                            Height="54"
                            Margin="0,0,18,0"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="ClearForm_Click"/>

                    <Button x:Name="SaveProductionButton"
                            Content="Save Production"
                            Width="220"
                            Height="54"
                            Background="#0EA5A8"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="SaveProduction_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

