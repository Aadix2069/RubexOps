<Page x:Class="RubexOps.EnterSalesDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Page.Resources>

        <Style TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="LockedFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#E8ECEF"/>
            <Setter Property="BorderBrush" Value="#C9CDD2"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
        </Style>

        <Style x:Key="RequiredStarStyle" TargetType="TextBlock">
            <Setter Property="Text" Value=" *"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Page.Resources>



    <Grid>

        <Image Source="Images/Rubex_logo.png"
               Width="550"
               Height="550"
               Opacity="0.3"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="0"/>



        <Grid x:Name="MainGrid"
              Margin="24"
              Panel.ZIndex="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="68"
                        Height="68"
                        CornerRadius="34"
                        Background="#AAFFFFFF"
                        BorderBrush="#90FFFFFF"
                        BorderThickness="1">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <materialDesign:PackIcon Kind="DatabasePlus"
                                             Width="32"
                                             Height="32"
                                             Foreground="#0B8A8F"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Enter Sales Data"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <Border Width="356"
                            Height="4"
                            Background="#F59E42"
                            CornerRadius="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>

            </Grid>



            <Border Grid.Row="2"
                    Background="#88FFFFFF"
                    CornerRadius="24"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1"
                    Padding="35">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="35"
                                      ShadowDepth="0"
                                      Opacity="0.10"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>



                        <TextBlock Text="Customer Details"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,0,0,18"/>

                        <Border Background="#55FFFFFF"
                                CornerRadius="18"
                                BorderBrush="#88FFFFFF"
                                BorderThickness="1"
                                Padding="24">

                            <StackPanel>

                                <Grid Margin="0,0,0,18">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Search Contract"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"/>
                                    </StackPanel>

                                    <Grid Grid.Column="1">

                                        <TextBox x:Name="CustomerSearchBox"
                                                 Height="50"
                                                 FontSize="15"
                                                 Padding="14,5"
                                                 VerticalContentAlignment="Center"
                                                 Background="#66FFFFFF"
                                                 BorderBrush="#99FFFFFF"
                                                 BorderThickness="1.2"
                                                 TextChanged="CustomerSearchBox_TextChanged"
                                                 Tag="Search using Customer Name or ID"/>

                                        <TextBlock x:Name="SearchPlaceholder"
                                                   Text="Search using Customer Name or ID"
                                                   FontSize="14"
                                                   Foreground="#9CA3AF"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>

                                        <Popup x:Name="CustomerSuggestionPopup"
                                               PlacementTarget="{Binding ElementName=CustomerSearchBox}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               Width="{Binding ActualWidth, ElementName=CustomerSearchBox}">

                                            <Border Background="#FDFDFD"
                                                    BorderBrush="#D1D5DB"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    MaxHeight="260">

                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.14"/>
                                                </Border.Effect>

                                                <ListBox x:Name="CustomerSuggestionList"
                                                         BorderThickness="0"
                                                         Background="Transparent">

                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="CustomerSuggestionItem_PreviewMouseLeftButtonUp"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F0FDFE"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>

                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="14,10">
                                                                <TextBlock Text="{Binding CustomerName}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#111827"/>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,3,0,0">
                                                                    <TextBlock Text="ID: "
                                                                               FontSize="13"
                                                                               Foreground="#6B7280"/>
                                                                    <TextBlock Text="{Binding CustomerID}"
                                                                               FontSize="13"
                                                                               Foreground="#6B7280"/>
                                                                    <TextBlock Text="  •  "
                                                                               FontSize="13"
                                                                               Foreground="#9CA3AF"/>
                                                                    <TextBlock Text="{Binding ItemCode}"
                                                                               FontSize="13"
                                                                               Foreground="#0B8A8F"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>

                                                </ListBox>

                                            </Border>

                                        </Popup>

                                    </Grid>

                                </Grid>

                                <Border Height="1"
                                        Background="#E5E7EB"
                                        Margin="0,0,0,18"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="72"/>
                                        <RowDefinition Height="72"/>
                                        <RowDefinition Height="72"/>
                                        <RowDefinition Height="72"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Customer Name"
                                               Grid.Row="0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="#111827"/>

                                    <TextBlock Text="Customer ID"
                                               Grid.Row="1"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="#111827"/>

                                    <TextBlock Text="Item Code"
                                               Grid.Row="2"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="#111827"/>

                                    <TextBlock Text="Base Rate (per kg)"
                                               Grid.Row="3"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="#111827"/>

                                    <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="CustomerNameBox"
                                                 Style="{StaticResource LockedFieldStyle}"/>
                                        <materialDesign:PackIcon Kind="LockOutline"
                                                                 Width="16" Height="16"
                                                                 Foreground="#9CA3AF"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,12,0"
                                                                 IsHitTestVisible="False"/>
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="CustomerIDBox"
                                                 Style="{StaticResource LockedFieldStyle}"/>
                                        <materialDesign:PackIcon Kind="LockOutline"
                                                                 Width="16" Height="16"
                                                                 Foreground="#9CA3AF"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,12,0"
                                                                 IsHitTestVisible="False"/>
                                    </Grid>

                                    <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="ItemCodeBox"
                                                 Style="{StaticResource LockedFieldStyle}"/>
                                        <materialDesign:PackIcon Kind="LockOutline"
                                                                 Width="16" Height="16"
                                                                 Foreground="#9CA3AF"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,12,0"
                                                                 IsHitTestVisible="False"/>
                                    </Grid>

                                    <Grid Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="BaseRateBox"
                                                 Style="{StaticResource LockedFieldStyle}"/>
                                        <materialDesign:PackIcon Kind="LockOutline"
                                                                 Width="16" Height="16"
                                                                 Foreground="#9CA3AF"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,12,0"
                                                                 IsHitTestVisible="False"/>
                                    </Grid>

                                </Grid>

                                <Border x:Name="ContractPeriodBadge"
                                        Background="#F0FDFE"
                                        BorderBrush="#A5F3FC"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,10"
                                        Margin="0,14,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarCheck"
                                                                 Width="18" Height="18"
                                                                 Foreground="#0B8A8F"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"/>
                                        <TextBlock x:Name="ContractPeriodText"
                                                   FontSize="14"
                                                   Foreground="#0B8A8F"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                        </Border>



                        <TextBlock Text="Sales Entry"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,42,0,18"/>

                        <Border Background="#55FFFFFF"
                                CornerRadius="18"
                                BorderBrush="#88FFFFFF"
                                BorderThickness="1"
                                Padding="24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="78"/>
                                    <RowDefinition Height="78"/>
                                    <RowDefinition Height="78"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Invoice Number"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RequiredStarStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Sales Order"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RequiredStarStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Dispatch"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" (optional)"
                                               FontSize="13"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBox x:Name="InvoiceNumberBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource InputFieldStyle}"
                                         VerticalAlignment="Center"/>

                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Background="#66FFFFFF"
                                        BorderBrush="#99FFFFFF"
                                        BorderThickness="1.2"
                                        CornerRadius="12"
                                        VerticalAlignment="Center"
                                        Height="50">
                                    <DatePicker x:Name="SalesOrderDatePicker"
                                                FontSize="15"
                                                Padding="10,0"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                SelectedDateChanged="SalesOrderDatePicker_SelectedDateChanged"/>
                                </Border>

                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Background="#66FFFFFF"
                                        BorderBrush="#99FFFFFF"
                                        BorderThickness="1.2"
                                        CornerRadius="12"
                                        VerticalAlignment="Center"
                                        Height="50">
                                    <DatePicker x:Name="DispatchDatePicker"
                                                FontSize="15"
                                                Padding="10,0"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"/>
                                </Border>

                            </Grid>

                        </Border>



                        <TextBlock Text="Weight Details"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,42,0,18"/>

                        <Border Background="#55FFFFFF"
                                CornerRadius="18"
                                BorderBrush="#88FFFFFF"
                                BorderThickness="1"
                                Padding="24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="78"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Weight"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RequiredStarStyle}"/>
                                </StackPanel>

                                <TextBox x:Name="WeightBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource InputFieldStyle}"
                                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>



                        <TextBlock Text="Rates &amp; Charges"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,42,0,18"/>

                        <Border Background="#55FFFFFF"
                                CornerRadius="18"
                                BorderBrush="#88FFFFFF"
                                BorderThickness="1"
                                Padding="24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="78"/>
                                    <RowDefinition Height="78"/>
                                    <RowDefinition Height="78"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="GST (%)"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RequiredStarStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="TCS 194Q (%)"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RequiredStarStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Loading Charge"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" (optional)"
                                               FontSize="13"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBox x:Name="GstBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource InputFieldStyle}"
                                         Text="5"
                                         VerticalAlignment="Center"/>

                                <TextBox x:Name="TcsBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Style="{StaticResource InputFieldStyle}"
                                         Text="0.1"
                                         VerticalAlignment="Center"/>

                                <TextBox x:Name="LoadingChargeBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Style="{StaticResource InputFieldStyle}"
                                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>



                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,45,0,0">

                            <Button Content="Clear Form"
                                    Width="160"
                                    Height="54"
                                    Margin="0,0,18,0"
                                    Background="#E5E7EB"
                                    Foreground="#111827"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ClearForm_Click">

                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Opacity="0.10"/>
                                </Button.Effect>

                            </Button>

                            <Button x:Name="SaveSalesButton"
                                    Content="Save Sales"
                                    Width="210"
                                    Height="54"
                                    Background="#0EA5A8"
                                    Foreground="White"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="SaveSales_Click">

                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0.18"/>
                                </Button.Effect>

                            </Button>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</Page>