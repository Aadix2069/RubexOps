<Page x:Class="RubexOps.EnterSalesDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="68" Height="68" CornerRadius="34" Background="#E7F6F7">
                <materialDesign:PackIcon Kind="DatabasePlus"
                                         Width="32"
                                         Height="32"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Enter Sales Data" FontSize="38" FontWeight="Bold" Foreground="#111827"/>
                <Border Width="350" Height="4" Background="#F59E42" CornerRadius="2" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="20" BorderBrush="#E5E7EB" BorderThickness="1" Padding="35">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Customer Selection" FontSize="26" FontWeight="Bold" Foreground="#0B8A8F" Margin="0,0,0,28"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Search Customer *" Grid.Row="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Customer Name" Grid.Row="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Customer ID" Grid.Row="2" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Item Code" Grid.Row="3" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <Grid Grid.Row="0" Grid.Column="1">
                            <TextBox x:Name="CustomerSearchBox"
                                     Height="50"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     TextChanged="CustomerSearchBox_TextChanged"/>

                            <Popup x:Name="CustomerSuggestionPopup"
                                   PlacementTarget="{Binding ElementName=CustomerSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Width="{Binding ActualWidth, ElementName=CustomerSearchBox}">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="220">
                                    <ListBox x:Name="CustomerSuggestionList"
                                             BorderThickness="0"
                                             SelectionChanged="CustomerSuggestionList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="10,8">
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CustomerID}" FontSize="13" Foreground="#6B7280" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding ItemCode}" FontSize="13" Foreground="#0B8A8F" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBox x:Name="CustomerNameBox" Grid.Row="1" Grid.Column="1" Height="50" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                        <TextBox x:Name="CustomerIDBox" Grid.Row="2" Grid.Column="1" Height="50" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                        <TextBox x:Name="ItemCodeBox" Grid.Row="3" Grid.Column="1" Height="50" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                    </Grid>

                    <TextBlock Text="Sales Details" FontSize="26" FontWeight="Bold" Foreground="#0B8A8F" Margin="0,42,0,28"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Invoice Number *" Grid.Row="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Sales Order *" Grid.Row="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Dispatch *" Grid.Row="2" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBox x:Name="InvoiceNumberBox" Grid.Row="0" Grid.Column="1" Height="50" FontSize="15" Padding="14,5"/>
                        <DatePicker x:Name="SalesOrderDatePicker" Grid.Row="1" Grid.Column="1" Height="54" FontSize="16" Padding="12,0"/>
                        <DatePicker x:Name="DispatchDatePicker" Grid.Row="2" Grid.Column="1" Height="54" FontSize="16" Padding="12,0"/>
                    </Grid>

                    <TextBlock Text="Quantity, Rate and Tax" FontSize="26" FontWeight="Bold" Foreground="#0B8A8F" Margin="0,42,0,28"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Weight / Sold Qty *" Grid.Row="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Base Rate *" Grid.Row="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="GST (%) *" Grid.Row="2" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="TCS 194Q (%) *" Grid.Row="3" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Loading Charge" Grid.Row="4" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBox x:Name="WeightBox" Grid.Row="0" Grid.Column="1" Height="50" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="BaseRateBox" Grid.Row="1" Grid.Column="1" Height="50" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="GstPercentBox" Grid.Row="2" Grid.Column="1" Height="50" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="TcsPercentBox" Grid.Row="3" Grid.Column="1" Height="50" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="LoadingChargeBox" Grid.Row="4" Grid.Column="1" Height="50" FontSize="15" Padding="14,5"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,45,0,0">
                        <Button Content="Clear Form" Width="160" Height="54" Margin="0,0,18,0" Background="#E5E7EB" Foreground="#111827" FontSize="15" FontWeight="SemiBold" BorderThickness="0" Click="ClearForm_Click"/>
                        <Button x:Name="SaveSalesButton" Content="Save Sales" Width="210" Height="54" Background="#0EA5A8" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="SaveSales_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>

