<Page x:Class="RubexOps.CreatePurchaseContractPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Page.Resources>

        <Style TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </Page.Resources>



    <Grid x:Name="MainGrid"
          Margin="24">

        <!-- ================================================= -->
        <!-- PAGE STRUCTURE -->
        <!-- ================================================= -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <!-- ================================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



            <!-- ICON -->

            <Border Width="68"
                    Height="68"
                    CornerRadius="34"
                    Background="#E7F6F7">

                <materialDesign:PackIcon Kind="FileDocumentEdit"
                                         Width="32"
                                         Height="32"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>



            <!-- TITLE -->

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="Create Purchase Contract"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <Border Width="451"
                        Height="4"
                        Background="#F59E42"
                        CornerRadius="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>



        <!-- ================================================= -->
        <!-- MAIN CARD -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="35">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>



                    <!-- ================================================= -->
                    <!-- CONTRACT DETAILS -->
                    <!-- ================================================= -->

                    <TextBlock Text="Contract Details"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,0,0,28"/>



                    <!-- ================================================= -->
                    <!-- FORM GRID -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                        </Grid.RowDefinitions>



                        <!-- LABELS -->

                        <TextBlock Text="Vendor Name"
                                   Grid.Row="0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>

                        <TextBlock Text="Vendor ID"
                                   Grid.Row="1"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>

                        <TextBlock Text="Item Code"
                                   Grid.Row="2"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>

                        <TextBlock Text="Start Date"
                                   Grid.Row="3"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>

                        <TextBlock Text="End Date"
                                   Grid.Row="4"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>

                        <TextBlock Text="Base Price"
                                   Grid.Row="5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>

                        <TextBlock Text="Agreed Quantity"
                                   Grid.Row="6"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>



                        <!-- INPUTS -->

                        <TextBox x:Name="VendorNameBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Height="50"
                                 FontSize="15"
                                 Padding="14,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"/>

                        <TextBox x:Name="VendorIDBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="50"
                                 FontSize="15"
                                 Padding="14,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"/>



                        <!-- LOCKED ITEM CODE -->

                        <TextBox x:Name="ItemCodeBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Height="50"
                                 FontSize="15"
                                 Padding="14,5"
                                 VerticalContentAlignment="Center"
                                 Text="NRFC"
                                 IsReadOnly="True"
                                 Background="#F3F4F6"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"/>



                        <!-- START DATE -->

                        <DatePicker x:Name="StartDatePicker"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Height="54"
                                    FontSize="16"
                                    Padding="12,0"
                                    VerticalContentAlignment="Center"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1.5"/>



                        <!-- END DATE -->

                        <DatePicker x:Name="EndDatePicker"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Height="54"
                                    FontSize="16"
                                    Padding="12,0"
                                    VerticalContentAlignment="Center"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1.5"/>



                        <!-- BASE PRICE -->

                        <TextBox x:Name="BasePriceBox"
                                 Grid.Row="5"
                                 Grid.Column="1"
                                 Height="50"
                                 FontSize="15"
                                 Padding="14,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"/>



                        <!-- AGREED QUANTITY -->

                        <TextBox x:Name="AgreedQuantityBox"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Height="50"
                                 FontSize="15"
                                 Padding="14,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"/>
                    </Grid>



                    <!-- ================================================= -->
                    <!-- BREACH LOGIC -->
                    <!-- ================================================= -->

                    <TextBlock Text="Breach Logic"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,42,0,28"/>



                    <!-- ================================================= -->
                    <!-- BREACH GRID -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                        </Grid.RowDefinitions>



                        <!-- LABELS -->

                        <TextBlock Text="Penalty / Discount Rate"
                                   Grid.Row="0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>

                        <TextBlock Text="Remedy Days"
                                   Grid.Row="1"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"/>



                        <!-- INPUTS -->

                        <TextBox x:Name="PenaltyRateBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Height="50"
                                 FontSize="15"
                                 Padding="14,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"/>

                        <TextBox x:Name="RemedyDaysBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="50"
                                 FontSize="15"
                                 Padding="14,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"/>
                    </Grid>



                    <!-- ================================================= -->
                    <!-- BUTTONS -->
                    <!-- ================================================= -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,45,0,0">

                        <!-- CLEAR -->

                        <Button Content="Clear Form"
                                Width="160"
                                Height="54"
                                Margin="0,0,18,0"
                                Background="#E5E7EB"
                                Foreground="#111827"
                                FontSize="15"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ClearForm_Click"/>



                        <!-- CREATE -->

                        <Button x:Name="CreateContractButton"
                                Content="Create Contract"
                                Width="210"
                                Height="54"
                                Background="#0EA5A8"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CreateContract_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>