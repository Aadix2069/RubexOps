<Page x:Class="RubexOps.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F4F7F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="35">

            <!-- PAGE HEADER -->
            <StackPanel Orientation="Horizontal">

                <!-- ICON -->
                <Border Width="65"
                        Height="65"
                        CornerRadius="32.5"
                        Background="#EAF7F7">

                    <materialDesign:PackIcon Kind="Home"
                                             Width="30"
                                             Height="30"
                                             Foreground="#0B7A81"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>


                <!-- TITLE -->
                <StackPanel Margin="18,0,0,0">

                    <TextBlock Text="Home"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="#1E2F35"/>

                    <Border Width="118"
                            Height="4"
                            Background="#F4A261"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>


            <!-- MAIN WELCOME CARD -->
            <Border Background="White"
                    CornerRadius="18"
                    Margin="0,35,0,0"
                    Padding="35"
                    BorderBrush="#E4E7E8"
                    BorderThickness="1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>


                    <!-- LEFT CONTENT -->
                    <StackPanel Margin="0,0,35,0">

                        <TextBlock Text="Welcome to RubexOps"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#0B7A81"/>

                        <TextBlock Text="RubexOps is an integrated desktop operations management system designed to streamline the complete workflow of rubber procurement, production, and sales within a manufacturing environment. The application centralizes contract management, purchase tracking, sales monitoring, and daily production operations into a single user-friendly platform, replacing complex manual Excel workflows with a structured and validated software system. Built with a modern desktop interface, the software enables users to create, renew, edit, and monitor purchase and sales contracts, record transactional entries, track production batches, and maintain full traceability from raw material procurement to finished product sales."
                                   FontSize="18"
                                   Margin="0,25,0,0"
                                   Foreground="#555"
                                   TextWrapping="Wrap"
                                   LineHeight="32"/>

                        <TextBlock Text="The system also incorporates intelligent validation and error-prevention mechanisms to ensure operational accuracy — such as preventing transactions outside contract periods, restricting overconsumption of inventory, validating production balances, and maintaining data integrity across all modules. By combining automation, centralized data handling, batch-level traceability, and analytical readiness, the application serves as a lightweight ERP-style operational platform tailored specifically for rubber manufacturing and trading operations."
                                   FontSize="18"
                                   Margin="0,20,0,0"
                                   Foreground="#555"
                                   TextWrapping="Wrap"
                                   LineHeight="32"/>


                        <!-- FEATURE ROW -->
                        <WrapPanel Margin="0,40,0,0">


                            <!-- FEATURE 1 -->
                            <Border Width="240"
                                    Background="#F6FAFA"
                                    CornerRadius="12"
                                    Padding="18"
                                    Margin="0,0,18,18">

                                <StackPanel>

                                    <materialDesign:PackIcon Kind="ClipboardCheck"
                                                             Width="40"
                                                             Height="40"
                                                             Foreground="#0B7A81"/>

                                    <TextBlock Text="Integrated Operations"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,0"
                                               Foreground="#1E2F35"/>

                                    <TextBlock Text="Manage procurement, sales, and production in one centralized system."
                                               FontSize="14"
                                               Margin="0,10,0,0"
                                               Foreground="#666"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>


                            <!-- FEATURE 2 -->
                            <Border Width="240"
                                    Background="#F6FAFA"
                                    CornerRadius="12"
                                    Padding="18"
                                    Margin="0,0,18,18">

                                <StackPanel>

                                    <materialDesign:PackIcon Kind="ShieldCheck"
                                                             Width="40"
                                                             Height="40"
                                                             Foreground="#0B7A81"/>

                                    <TextBlock Text="Data Accuracy &amp; Control"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,0"
                                               Foreground="#1E2F35"/>

                                    <TextBlock Text="Reduce operational errors with validations and approval workflows."
                                               FontSize="14"
                                               Margin="0,10,0,0"
                                               Foreground="#666"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>


                            <!-- FEATURE 3 -->
                            <Border Width="240"
                                    Background="#F6FAFA"
                                    CornerRadius="12"
                                    Padding="18"
                                    Margin="0,0,18,18">

                                <StackPanel>

                                    <materialDesign:PackIcon Kind="ChartBar"
                                                             Width="40"
                                                             Height="40"
                                                             Foreground="#0B7A81"/>

                                    <TextBlock Text="Reports &amp; Insights"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,0"
                                               Foreground="#1E2F35"/>

                                    <TextBlock Text="Generate powerful reports and insights for smarter business decisions."
                                               FontSize="14"
                                               Margin="0,10,0,0"
                                               Foreground="#666"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <!-- USER FRIENDLY INTERFACE -->
                            <Border Width="240"
        Background="#F6FAFA"
        CornerRadius="12"
        Padding="18"
        Margin="0,0,18,18">

                                <StackPanel>

                                    <!-- ICON -->
                                    <materialDesign:PackIcon Kind="MonitorDashboard"
                                 Width="40"
Height="40"
Foreground="#0B7A81"/>


                                    <!-- TITLE -->
                                    <TextBlock Text="User Friendly Interface"
                  FontSize="18"
FontWeight="SemiBold"
Margin="0,15,0,0"
Foreground="#1E2F35"/>

                                    <!-- DESCRIPTION -->
                                    <TextBlock Text="Navigate operations easily with a clean interface designed for efficient workflow management."
                   FontSize="14"
 Margin="0,10,0,0"
 Foreground="#666"
 TextWrapping="Wrap"/>

                                </StackPanel>
                            </Border>
                        </WrapPanel>


                        <!-- QUOTE BAR -->
                        <Border Background="#EAF7F7"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,25,0,0">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="StarCircle"
                                                         Width="28"
                                                         Height="28"
                                                         Foreground="#0B7A81"
                                                         Margin="0,0,15,0"/>

                                <TextBlock Text="Our mission is to simplify operations, improve productivity and work efficiency."
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="#0B7A81"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- RIGHT SIDE IMAGE AREA -->
                    <Border Grid.Column="1"
        Background="#EAF7F7"
        CornerRadius="18"
        Margin="0,0,0,0"
        ClipToBounds="True">

                        <Grid>

                            <!-- IMAGE -->
                            <Image Source="/Assets/factory_dashboard.png"
               Stretch="UniformToFill"/>

                            <!-- OPTIONAL OVERLAY -->
                            <Border Background="#10FFFFFF"/>

                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>