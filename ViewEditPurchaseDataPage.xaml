<Page x:Class="RubexOps.ViewEditPurchaseDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Page.Resources>

        <Style TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="FormLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="DetailLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <Style x:Key="DetailValue"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

    </Page.Resources>

    <!-- ================================================= -->
    <!-- ROOT GRID -->
    <!-- ================================================= -->

    <Grid>

        <!-- ================================================= -->
        <!-- FIXED WATERMARK -->
        <!-- ================================================= -->

        <Image Source="Images/Rubex_logo.png"
               Width="500"
               Height="500"
               Opacity="0.13"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="0"/>



        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <Grid x:Name="MainGrid"
              Margin="24"
              Panel.ZIndex="1">

            <!-- ================================================= -->
            <!-- PAGE STRUCTURE -->
            <!-- ================================================= -->

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <!-- ================================================= -->
            <!-- PAGE HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



                <!-- ICON -->

                <Border Width="68"
                        Height="68"
                        CornerRadius="34"
                        Background="#AAFFFFFF"
                        BorderBrush="#90FFFFFF"
                        BorderThickness="1">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <materialDesign:PackIcon Kind="TableEdit"
                                             Width="32"
                                             Height="32"
                                             Foreground="#0B8A8F"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>



                <!-- TITLE -->

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="View / Edit Purchase Data"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <Border Width="470"
                            Height="4"
                            Background="#F59E42"
                            CornerRadius="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>

            </Grid>



            <!-- ================================================= -->
            <!-- MAIN GLASS CARD -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="#88FFFFFF"
                    CornerRadius="24"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1"
                    Padding="28">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="35"
                                      ShadowDepth="0"
                                      Opacity="0.10"/>
                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>



                    <!-- ================================================= -->
                    <!-- CONTROLS -->
                    <!-- ================================================= -->

                    <Border Grid.Row="0"
                            Background="#55FFFFFF"
                            CornerRadius="18"
                            BorderBrush="#88FFFFFF"
                            BorderThickness="1"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>



                            <!-- SEARCH -->

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">

                                <TextBlock Text="Search Vendor"
                                           Style="{StaticResource FormLabel}"/>

                                <Grid>

                                    <TextBox x:Name="SearchBox"
                                             Height="46"
                                             FontSize="15"
                                             Padding="42,5,14,5"
                                             VerticalContentAlignment="Center"
                                             Background="#66FFFFFF"
                                             BorderBrush="#99FFFFFF"
                                             BorderThickness="1.2"
                                             TextChanged="SearchBox_TextChanged"/>

                                    <materialDesign:PackIcon Kind="Magnify"
                                                             Width="21"
                                                             Height="21"
                                                             Foreground="#6B7280"
                                                             Margin="13,0,0,0"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>



                            <!-- DATE MODE -->

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,16,0">

                                <TextBlock Text="Date Filter"
                                           Style="{StaticResource FormLabel}"/>

                                <ComboBox x:Name="DateModeComboBox"
                                          Height="46"
                                          FontSize="14"
                                          Padding="10,0"
                                          Background="#66FFFFFF"
                                          BorderBrush="#99FFFFFF"
                                          BorderThickness="1.2"
                                          SelectionChanged="DateModeComboBox_SelectionChanged">

                                    <ComboBoxItem Content="All Time"
                                                  Tag="AllTime"
                                                  IsSelected="True"/>

                                    <ComboBoxItem Content="Date Range"
                                                  Tag="DateRange"/>

                                    <ComboBoxItem Content="Particular Day"
                                                  Tag="ParticularDay"/>
                                </ComboBox>
                            </StackPanel>



                            <!-- FROM DATE -->

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,16,0">

                                <TextBlock x:Name="FromDateLabel"
                                           Text="From Date"
                                           Style="{StaticResource FormLabel}"/>

                                <Border Background="#66FFFFFF"
                                        BorderBrush="#99FFFFFF"
                                        BorderThickness="1.2"
                                        CornerRadius="12">

                                    <DatePicker x:Name="FromDatePicker"
                                                Height="46"
                                                FontSize="14"
                                                Padding="10,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                                </Border>
                            </StackPanel>



                            <!-- TO DATE -->

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,16,0">

                                <TextBlock x:Name="ToDateLabel"
                                           Text="To Date"
                                           Style="{StaticResource FormLabel}"/>

                                <Border Background="#66FFFFFF"
                                        BorderBrush="#99FFFFFF"
                                        BorderThickness="1.2"
                                        CornerRadius="12">

                                    <DatePicker x:Name="ToDatePicker"
                                                Height="46"
                                                FontSize="14"
                                                Padding="10,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                                </Border>
                            </StackPanel>



                            <!-- SORT -->

                            <StackPanel Grid.Column="4"
                                        Margin="0,0,16,0">

                                <TextBlock Text="Sort"
                                           Style="{StaticResource FormLabel}"/>

                                <ComboBox x:Name="SortComboBox"
                                          Height="46"
                                          FontSize="14"
                                          Padding="10,0"
                                          Background="#66FFFFFF"
                                          BorderBrush="#99FFFFFF"
                                          BorderThickness="1.2"
                                          SelectionChanged="SortComboBox_SelectionChanged">

                                    <ComboBoxItem Content="Name Ascending"
                                                  Tag="NameAsc"
                                                  IsSelected="True"/>

                                    <ComboBoxItem Content="Name Descending"
                                                  Tag="NameDesc"/>

                                    <ComboBoxItem Content="Net Payable Ascending"
                                                  Tag="NetPayableAsc"/>

                                    <ComboBoxItem Content="Net Payable Descending"
                                                  Tag="NetPayableDesc"/>

                                    <ComboBoxItem Content="DRC Ascending"
                                                  Tag="DrcAsc"/>

                                    <ComboBoxItem Content="DRC Descending"
                                                  Tag="DrcDesc"/>

                                </ComboBox>
                            </StackPanel>



                            <!-- ACTION BUTTONS -->

                            <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">

                                <Button Width="46"
                                        Height="46"
                                        Margin="0,0,10,0"
                                        Background="#E5E7EB"
                                        Foreground="#111827"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ClearFilters_Click"
                                        ToolTip="Clear filters">

                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Opacity="0.10"/>
                                    </Button.Effect>

                                    <materialDesign:PackIcon Kind="FilterRemove"
                                                             Width="22"
                                                             Height="22"/>
                                </Button>



                                <Button Width="46"
                                        Height="46"
                                        Background="#0EA5A8"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="Refresh_Click"
                                        ToolTip="Refresh data">

                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.18"/>
                                    </Button.Effect>

                                    <materialDesign:PackIcon Kind="Refresh"
                                                             Width="22"
                                                             Height="22"/>
                                </Button>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- ================================================= -->
                    <!-- PURCHASE DATA GRID -->
                    <!-- ================================================= -->

                    <Border Grid.Row="2"
                            Background="#55FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            ClipToBounds="True">

                        <DataGrid x:Name="PurchaseDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="42"
                                  FontSize="13"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  AlternatingRowBackground="#35FFFFFF"
                                  SelectionMode="Single"
                                  SelectionChanged="PurchaseDataGrid_SelectionChanged">

                            <!-- ROW STYLE -->

                            <DataGrid.RowStyle>

                                <Style TargetType="DataGridRow">

                                    <Setter Property="Background"
                                            Value="#20FFFFFF"/>

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Setter Property="MinHeight"
                                            Value="42"/>

                                </Style>

                            </DataGrid.RowStyle>



                            <!-- HEADER STYLE -->

                            <DataGrid.ColumnHeaderStyle>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background"
                                            Value="#50FFFFFF"/>

                                    <Setter Property="Foreground"
                                            Value="#111827"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="Height"
                                            Value="46"/>

                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                </Style>

                            </DataGrid.ColumnHeaderStyle>



                            <!-- COLUMNS -->

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header=""
                                                        Width="54">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Width="34"
                                                    Height="30"
                                                    Background="#0EA5A8"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="EditPurchase_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Edit input values">

                                                <Button.Effect>
                                                    <DropShadowEffect BlurRadius="10"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.15"/>
                                                </Button.Effect>

                                                <materialDesign:PackIcon Kind="Pencil"
                                                                         Width="16"
                                                                         Height="16"/>
                                            </Button>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Vendor Name"
                                                    Binding="{Binding VendorName}"
                                                    Width="170"/>

                                <DataGridTextColumn Header="Vendor ID"
                                                    Binding="{Binding VendorID}"
                                                    Width="95"/>

                                <DataGridTextColumn Header="Invoice No."
                                                    Binding="{Binding InvoiceNumber}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Purchase Order"
                                                    Binding="{Binding PurchaseOrderDate}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Delivery"
                                                    Binding="{Binding DeliveryDate}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Before Unloading"
                                                    Binding="{Binding BeforeUnloading}"
                                                    Width="125"/>

                                <DataGridTextColumn Header="Carrier Weight"
                                                    Binding="{Binding CarrierWeight}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Net Weight"
                                                    Binding="{Binding NetWeight}"
                                                    Width="105"/>

                                <DataGridTextColumn Header="DRC (%)"
                                                    Binding="{Binding CalculatedDrc}"
                                                    Width="85"/>

                                <DataGridTextColumn Header="DRC Weight"
                                                    Binding="{Binding DrcWeight}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Base Rate"
                                                    Binding="{Binding BaseRate}"
                                                    Width="95"/>

                                <DataGridTextColumn Header="GST (%)"
                                                    Binding="{Binding GstPercent}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="TDS 194Q (%)"
                                                    Binding="{Binding Tds194QPercent}"
                                                    Width="105"/>

                                <DataGridTextColumn Header="Taxable Amount"
                                                    Binding="{Binding TaxableAmount}"
                                                    Width="125"/>

                                <DataGridTextColumn Header="Unloading"
                                                    Binding="{Binding UnloadingCharge}"
                                                    Width="95"/>

                                <DataGridTextColumn Header="Net Payable"
                                                    Binding="{Binding NetPayable}"
                                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>



                    <!-- ================================================= -->
                    <!-- SELECTED DETAILS -->
                    <!-- ================================================= -->

                    <Border Grid.Row="4"
                            Background="#55FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="20">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0.08"/>
                        </Border.Effect>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>



                            <!-- TOP SECTION -->

                            <Grid Grid.Row="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock x:Name="SelectedVendorNameText"
                                               Text="Select a purchase row"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#0B8A8F"/>

                                    <TextBlock x:Name="SelectedInvoiceText"
                                               Text="Purchase details will appear here."
                                               FontSize="14"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="ResultCountText"
                                           Grid.Column="1"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           VerticalAlignment="Center"/>
                            </Grid>



                            <!-- DETAIL GRID -->

                            <Grid Grid.Row="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>



                                <StackPanel Grid.Column="0"
                                            Margin="0,0,20,0">

                                    <TextBlock Text="Delivery Date"
                                               Style="{StaticResource DetailLabel}"/>

                                    <TextBlock x:Name="DetailDeliveryDateText"
                                               Text="-"
                                               Style="{StaticResource DetailValue}"/>
                                </StackPanel>



                                <StackPanel Grid.Column="1"
                                            Margin="0,0,20,0">

                                    <TextBlock Text="Net Weight"
                                               Style="{StaticResource DetailLabel}"/>

                                    <TextBlock x:Name="DetailNetWeightText"
                                               Text="-"
                                               Style="{StaticResource DetailValue}"/>
                                </StackPanel>



                                <StackPanel Grid.Column="2"
                                            Margin="0,0,20,0">

                                    <TextBlock Text="DRC"
                                               Style="{StaticResource DetailLabel}"/>

                                    <TextBlock x:Name="DetailDrcText"
                                               Text="-"
                                               Style="{StaticResource DetailValue}"/>
                                </StackPanel>



                                <StackPanel Grid.Column="3"
                                            Margin="0,0,20,0">

                                    <TextBlock Text="Taxable Amount"
                                               Style="{StaticResource DetailLabel}"/>

                                    <TextBlock x:Name="DetailTaxableText"
                                               Text="-"
                                               Style="{StaticResource DetailValue}"/>
                                </StackPanel>



                                <StackPanel Grid.Column="4">

                                    <TextBlock Text="Net Payable"
                                               Style="{StaticResource DetailLabel}"/>

                                    <TextBlock x:Name="DetailNetPayableText"
                                               Text="-"
                                               Style="{StaticResource DetailValue}"/>
                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>