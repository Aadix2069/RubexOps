<Page x:Class="RubexOps.ViewSalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="68" Height="68" CornerRadius="34" Background="#E7F6F7">
                <materialDesign:PackIcon Kind="TableEdit"
                                         Width="32"
                                         Height="32"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="View Sales Data" FontSize="38" FontWeight="Bold" Foreground="#111827"/>
                <Border Width="390" Height="4" Background="#F59E42" CornerRadius="2" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="20" BorderBrush="#E5E7EB" BorderThickness="1" Padding="35">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Height="56"
                             FontSize="15"
                             Padding="14,5"
                             VerticalContentAlignment="Center"
                             ToolTip="Search customer, invoice, or item"
                             TextChanged="FilterChanged"/>

                    <TextBox x:Name="ItemFilterBox"
                             Grid.Column="2"
                             Height="56"
                             FontSize="15"
                             Padding="14,5"
                             VerticalContentAlignment="Center"
                             ToolTip="Filter by item code or name"
                             TextChanged="FilterChanged"/>

                    <DatePicker x:Name="FromDatePicker"
                                Grid.Column="4"
                                Height="56"
                                FontSize="15"
                                SelectedDateChanged="DateFilterChanged"/>

                    <DatePicker x:Name="ToDatePicker"
                                Grid.Column="6"
                                Height="56"
                                FontSize="15"
                                SelectedDateChanged="DateFilterChanged"/>

                    <ComboBox x:Name="SortComboBox"
                              Grid.Column="8"
                              Height="56"
                              FontSize="15"
                              Padding="12,0"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Name Ascending"/>
                        <ComboBoxItem Content="Name Descending"/>
                        <ComboBoxItem Content="Dispatch Newest"/>
                        <ComboBoxItem Content="Dispatch Oldest"/>
                        <ComboBoxItem Content="Amount High to Low"/>
                        <ComboBoxItem Content="Amount Low to High"/>
                    </ComboBox>

                    <Button Grid.Column="10"
                            Height="56"
                            Background="#0EA5A8"
                            BorderThickness="0"
                            Click="RefreshButton_Click">
                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="22"
                                                 Height="22"
                                                 Foreground="White"/>
                    </Button>
                </Grid>

                <DataGrid x:Name="SalesDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          FontSize="14"
                          SelectionChanged="SalesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding customer_name}" Width="190"/>
                        <DataGridTextColumn Header="Customer ID" Binding="{Binding customer_id}" Width="110"/>
                        <DataGridTextColumn Header="Item Code" Binding="{Binding item_code}" Width="90"/>
                        <DataGridTextColumn Header="Invoice No." Binding="{Binding invoice_number}" Width="130"/>
                        <DataGridTextColumn Header="Sales Order" Binding="{Binding sales_order}" Width="120"/>
                        <DataGridTextColumn Header="Dispatch" Binding="{Binding dispatch}" Width="120"/>
                        <DataGridTextColumn Header="Weight" Binding="{Binding WeightDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Base Rate" Binding="{Binding BaseRateDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Taxable Amount" Binding="{Binding TaxableAmountDisplay}" Width="140"/>
                        <DataGridTextColumn Header="Net Receivable" Binding="{Binding NetReceivableDisplay}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="4"
                        Background="#F9FAFB"
                        CornerRadius="16"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="SummaryTitleText" Text="No record selected" FontSize="24" FontWeight="Bold" Foreground="#0B8A8F"/>
                            <TextBlock x:Name="SummarySubtitleText" Text="Select a sales row to view details" FontSize="14" Foreground="#6B7280" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dispatch Date" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBlock x:Name="SummaryDispatchText" Text="-" FontSize="16" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Weight" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBlock x:Name="SummaryWeightText" Text="-" FontSize="16" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Taxable Amount" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBlock x:Name="SummaryTaxableText" Text="-" FontSize="16" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Net Receivable" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBlock x:Name="SummaryNetText" Text="-" FontSize="16" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>

