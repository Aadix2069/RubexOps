<Window x:Class="RubexOps.EditSalesContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Edit Sales Contract"
        Height="820"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7F8">

    <Window.Resources>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Foreground"
                    Value="#111827"/>
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Padding"
                    Value="14,5"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#70FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#99FFFFFF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="InputDatePickerStyle"
               TargetType="DatePicker">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Background"
                    Value="#70FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#99FFFFFF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="GlassCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Image Source="Images/Rubex_logo.png"
               Width="600"
               Height="600"
               Opacity="0.16"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="0"/>

        <Grid x:Name="MainGrid"
              Margin="24"
              Panel.ZIndex="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">

                <Border Width="58"
                        Height="58"
                        CornerRadius="29"
                        Background="#AAFFFFFF"
                        BorderBrush="#80FFFFFF"
                        BorderThickness="1">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="0"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <materialDesign:PackIcon Kind="Pencil"
                                             Width="28"
                                             Height="28"
                                             Foreground="#0B8A8F"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Edit Sales Contract"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Update contract inputs and breach responsibility"
                               FontSize="14"
                               Margin="0,4,0,0"
                               Foreground="#6B7280"/>
                </StackPanel>

            </StackPanel>

            <Border Grid.Row="2"
                    CornerRadius="28"
                    Padding="30"
                    Background="#88FFFFFF"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="35"
                                      ShadowDepth="0"
                                      Opacity="0.16"/>
                </Border.Effect>

                <Grid>

                    <Border CornerRadius="24"
                            Background="#30FFFFFF"
                            Margin="-14"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Border Background="#70FFFFFF"
                                    CornerRadius="18"
                                    Padding="18"
                                    BorderBrush="#99FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,0,32">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="0"
                                                      Opacity="0.08"/>
                                </Border.Effect>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Current Contract"
                                                   FontSize="13"
                                                   Foreground="#6B7280"/>

                                        <TextBlock x:Name="ContractSummaryText"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#111827"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            x:Name="StatusBadge"
                                            Padding="14,7"
                                            CornerRadius="18"
                                            VerticalAlignment="Center">

                                        <TextBlock x:Name="StatusTextBlock"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>

                                </Grid>

                            </Border>

                            <TextBlock Text="Basic Contract Details"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"
                                       Margin="0,0,0,28"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Customer Name"
                                           Grid.Row="0"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Customer ID"
                                           Grid.Row="1"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Start Date"
                                           Grid.Row="2"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="End Date"
                                           Grid.Row="3"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Base Price"
                                           Grid.Row="4"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Agreed Quantity"
                                           Grid.Row="5"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="CustomerNameBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <TextBox x:Name="CustomerIDBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <DatePicker x:Name="StartDatePicker"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource InputDatePickerStyle}"
                                            SelectedDateFormat="Long"
                                            HorizontalContentAlignment="Stretch"/>

                                <DatePicker x:Name="EndDatePicker"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{StaticResource InputDatePickerStyle}"
                                            SelectedDateFormat="Long"
                                            HorizontalContentAlignment="Stretch"/>

                                <TextBox x:Name="BasePriceBox"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <TextBox x:Name="AgreedQtyBox"
                                         Grid.Row="5"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                            </Grid>

                            <TextBlock Text="Breach Handling"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"
                                       Margin="0,40,0,28"/>

                            <Border x:Name="BreachInfoCard"
                                    Background="#70FFFFFF"
                                    CornerRadius="18"
                                    BorderBrush="#99FFFFFF"
                                    BorderThickness="1"
                                    Padding="16"
                                    Margin="0,0,0,18">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="0"
                                                      Opacity="0.08"/>
                                </Border.Effect>

                                <StackPanel>

                                    <TextBlock x:Name="BreachInfoTitle"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#111827"/>

                                    <TextBlock x:Name="BreachInfoMessage"
                                               FontSize="13"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#70FFFFFF"
                                    CornerRadius="16"
                                    Padding="14"
                                    BorderBrush="#99FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,0,24">

                                <StackPanel>
                                    <CheckBox x:Name="IgnoreRemainingQtyCheckBox"
                                              Content="Ignore small remaining quantity and treat contract as completed"
                                              Style="{StaticResource GlassCheckBoxStyle}"/>

                                    <TextBlock Text="Use this only when the remaining quantity is intentionally left unpurchased near contract end."
                                               FontSize="12.5"
                                               Foreground="#6B7280"
                                               Margin="28,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="BreachGrid">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Penalty Percentage"
                                           Grid.Row="0"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Remedy Days"
                                           Grid.Row="1"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Breach Responsibility"
                                           Grid.Row="2"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Revised Rate"
                                           Grid.Row="3"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock Text="Remedy Deadline"
                                           Grid.Row="4"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="PenaltyPercentBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <TextBox x:Name="RemedyDaysBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Background="#70FFFFFF"
                                        BorderBrush="#99FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14">

                                    <ComboBox x:Name="ResponsibilityComboBox"
                                              Height="46"
                                              FontSize="15"
                                              Padding="10,0"
                                              VerticalContentAlignment="Center"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              SelectionChanged="ResponsibilityComboBox_SelectionChanged">

                                        <ComboBoxItem Content="Pending"/>
                                        <ComboBoxItem Content="Customer"/>
                                        <ComboBoxItem Content="Company"/>

                                    </ComboBox>
                                </Border>

                                <TextBox x:Name="RevisedRateBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         IsReadOnly="True"
                                         Background="#60F3F4F6"/>

                                <TextBox x:Name="RemedyDeadlineBox"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         IsReadOnly="True"
                                         Background="#60F3F4F6"/>

                            </Grid>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="140"
                        Height="50"
                        Margin="0,0,16,0"
                        Background="#DDE5E7EB"
                        Foreground="#111827"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CancelButton_Click">

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="0"
                                          Opacity="0.10"/>
                    </Button.Effect>
                </Button>

                <Button x:Name="SaveButton"
                        Content="Save Changes"
                        Width="190"
                        Height="50"
                        Background="#0EA5A8"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SaveButton_Click">

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="14"
                                          ShadowDepth="0"
                                          Opacity="0.18"/>
                    </Button.Effect>
                </Button>

            </StackPanel>

        </Grid>

    </Grid>

</Window>