<Window x:Class="RubexOps.EditContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Edit Contract"
        Height="760"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7F8">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <StackPanel Orientation="Horizontal">
            <Border Width="58"
                    Height="58"
                    CornerRadius="29"
                    Background="#E7F6F7">

                <materialDesign:PackIcon Kind="Pencil"
                                         Width="28"
                                         Height="28"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="18,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="Edit Purchase Contract"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Update contract inputs and breach responsibility"
                           FontSize="14"
                           Margin="0,4,0,0"
                           Foreground="#6B7280"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================= -->
        <!-- MAIN CARD -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="30">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ================================================= -->
                    <!-- STATUS SUMMARY -->
                    <!-- ================================================= -->

                    <Border Background="#F9FAFB"
                            CornerRadius="16"
                            Padding="18"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Margin="0,0,0,32">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Current Contract"
                                           FontSize="13"
                                           Foreground="#6B7280"/>

                                <TextBlock x:Name="ContractSummaryText"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#111827"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    x:Name="StatusBadge"
                                    Padding="14,7"
                                    CornerRadius="18"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="StatusTextBlock"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================================================= -->
                    <!-- BASIC EDITS -->
                    <!-- ================================================= -->

                    <TextBlock Text="Basic Contract Details"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,0,0,28"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Vendor Name"
                                   Grid.Row="0"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock Text="Vendor ID"
                                   Grid.Row="1"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock Text="Base Price"
                                   Grid.Row="2"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock Text="Agreed Quantity"
                                   Grid.Row="3"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="VendorNameBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBox x:Name="VendorIDBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBox x:Name="BasePriceBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBox x:Name="AgreedQtyBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- BREACH LOGIC -->
                    <!-- ================================================= -->

                    <TextBlock Text="Breach Handling"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,40,0,28"/>

                    <Border x:Name="BreachInfoCard"
                            Background="#F9FAFB"
                            CornerRadius="14"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,24">

                        <StackPanel>
                            <TextBlock x:Name="BreachInfoTitle"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>

                            <TextBlock x:Name="BreachInfoMessage"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="BreachGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Penalty Percentage"
                                   Grid.Row="0"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock Text="Remedy Days"
                                   Grid.Row="1"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock Text="Breach Responsibility"
                                   Grid.Row="2"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock Text="Revised Rate"
                                   Grid.Row="3"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBlock Text="Remedy Deadline"
                                   Grid.Row="4"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="PenaltyPercentBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBox x:Name="RemedyDaysBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <ComboBox x:Name="ResponsibilityComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Height="46"
                                  FontSize="15"
                                  Padding="10,0"
                                  VerticalContentAlignment="Center"
                                  BorderBrush="#D1D5DB"
                                  BorderThickness="1.5"
                                  SelectionChanged="ResponsibilityComboBox_SelectionChanged">

                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Vendor"/>
                            <ComboBoxItem Content="Company"/>
                            <ComboBoxItem Content="Shared"/>
                        </ComboBox>

                        <TextBox x:Name="RevisedRateBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F3F4F6"/>

                        <TextBox x:Name="RemedyDeadlineBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F3F4F6"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================================================= -->
        <!-- BUTTONS -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="140"
                    Height="50"
                    Margin="0,0,16,0"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    FontSize="15"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Content="Save Changes"
                    Width="190"
                    Height="50"
                    Background="#0EA5A8"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>