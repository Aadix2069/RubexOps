<Page x:Class="RubexOps.ViewEditSalesContractsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Page.Resources>
        <Style x:Key="UnitRadioButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0EA5A8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Image x:Name="WatermarkLogo"
               Source="Images/Rubex_logo.png"
               Width="500"
               Height="500"
               Opacity="0.13"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="0"/>

        <Grid x:Name="MainGrid" Margin="24" Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto"/>
                <RowDefinition x:Name="HeaderSpacerRow" Height="18"/>
                <RowDefinition x:Name="LegendRow" Height="Auto"/>
                <RowDefinition x:Name="LegendSpacerRow" Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderSection" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="68" Height="68" CornerRadius="34"
                            Background="#AAFFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.12"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="FileDocumentMultiple"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#0B8A8F"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="View Sales Contracts"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Manage and monitor sales contract lifecycle"
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="190"
                            Height="54"
                            Margin="0,0,14,0"
                            Background="#0EA5A8"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RenewContract_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.18"/>
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,8,0"
                                                     Foreground="White"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Renew Contract"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Padding="18,12"
                            CornerRadius="18"
                            Background="#88FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.10"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Visible Contracts" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock Text="{Binding ElementName=ContractsItemsControl, Path=Items.Count}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border x:Name="StatusLegendPanel"
                    Grid.Row="2"
                    Background="#88FFFFFF"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.10"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <Ellipse Width="12" Height="12" Fill="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="Active" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <Ellipse Width="12" Height="12" Fill="#3B82F6" VerticalAlignment="Center"/>
                            <TextBlock Text="Upcoming" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <Ellipse Width="12" Height="12" Fill="#8B5CF6" VerticalAlignment="Center"/>
                            <TextBlock Text="Completed" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <Ellipse Width="12" Height="12" Fill="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="Violated" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="#F59E0B" VerticalAlignment="Center"/>
                            <TextBlock Text="Expired" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </WrapPanel>

                    <Border Grid.Column="1"
                            Width="226"
                            Height="42"
                            CornerRadius="14"
                            Background="#35FFFFFF"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            Padding="8,4"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Unit"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,10,0"/>
                            <Border Height="32"
                                    Background="#F8FAFC"
                                    CornerRadius="12"
                                    Padding="0"
                                    VerticalAlignment="Center">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="KgRadioButton"
                                                 GroupName="WeightUnit"
                                                 Content="Kg"
                                                 IsChecked="True"
                                                 Checked="UnitRadioButton_Checked"
                                                 Style="{StaticResource UnitRadioButtonStyle}"/>

                                    <RadioButton x:Name="TonnesRadioButton"
                                                 GroupName="WeightUnit"
                                                 Content="Tonnes"
                                                 Checked="UnitRadioButton_Checked"
                                                 Style="{StaticResource UnitRadioButtonStyle}"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.75*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.85*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="132"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 FontSize="15"
                                 Padding="46,0,18,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextChanged="SearchBox_TextChanged"/>

                        <materialDesign:PackIcon Kind="Magnify"
                                                 Width="22"
                                                 Height="22"
                                                 Margin="14,0,0,0"
                                                 Foreground="#6B7280"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>

                        <TextBlock Text="Search using Customer Name or ID"
                                   Margin="46,0,0,0"
                                   FontSize="14"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <ComboBox x:Name="FilterComboBox"
                                  FontSize="15"
                                  Padding="44,0,12,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="FilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="All Contracts"/>
                            <ComboBoxItem Content="All Contracts (Including Expired)"/>
                            <ComboBoxItem Content="Upcoming"/>
                            <ComboBoxItem Content="Completed"/>
                            <ComboBoxItem Content="Violated"/>
                            <ComboBoxItem Content="Expired"/>
                        </ComboBox>

                        <materialDesign:PackIcon Kind="FilterVariant"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#6B7280"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Margin="14,0,0,0"
                                                 IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <ComboBox x:Name="SortComboBox"
                                  FontSize="15"
                                  Padding="44,0,12,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="SortComboBox_SelectionChanged">
                            <ComboBoxItem Content="Name Ascending"/>
                            <ComboBoxItem Content="Name Descending"/>
                            <ComboBoxItem Content="Agreed Qty Ascending"/>
                            <ComboBoxItem Content="Agreed Qty Descending"/>
                        </ComboBox>

                        <materialDesign:PackIcon Kind="Sort"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#6B7280"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Margin="14,0,0,0"
                                                 IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Grid.Column="6"
                        Width="170"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Cards Per Row"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="6,0,8,0"/>

                        <ComboBox x:Name="CardsPerRowComboBox"
                                  Grid.Column="1"
                                  Height="34"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CardsPerRowComboBox_SelectionChanged">
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Column="8"
                        Width="132"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="10,0">
                    <CheckBox x:Name="FocusModeCheckBox"
                              Content="Focus Mode"
                              FontSize="12.5"
                              FontWeight="SemiBold"
                              Foreground="#374151"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Cursor="Hand"
                              Checked="FocusModeCheckBox_Checked"
                              Unchecked="FocusModeCheckBox_Checked"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="ContractsItemsControl"
                              Tag="3">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,18,22"
                                    Background="#88FFFFFF"
                                    CornerRadius="26"
                                    Padding="22"
                                    BorderBrush="#99FFFFFF"
                                    BorderThickness="1"
                                    Opacity="{Binding CardOpacity}"
                                    MinWidth="{Binding CardMinWidth, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                    HorizontalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.13"/>
                                </Border.Effect>

                                <Grid>
                                    <Border CornerRadius="22" Background="#22FFFFFF" Margin="-8"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="70"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding customer_name}"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="27"
                                                       Height="56"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,14,0"/>

                                            <Border Grid.Column="1"
                                                    Padding="12,6"
                                                    CornerRadius="12"
                                                    Background="{Binding StatusBackground}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="13"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Contract ID"
                                                           Style="{StaticResource MetricLabelStyle}"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ContractIdDisplay}"
                                                           Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Item Code"
                                                           Style="{StaticResource MetricLabelStyle}"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ItemCodeDisplay}"
                                                           Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Start Date" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding start_date}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="End Date" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding end_date}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Days Remaining" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding DaysRemainingDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Agreed Qty" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding AgreedQtyDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Base Price" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding BasePriceDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Sales" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding SalesSoFarDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Qty Sold So Far" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding QtySoldSoFarDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Remaining" Style="{StaticResource MetricLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding RemainingQtyDisplay}" Style="{StaticResource MetricValueStyle}"/>
                                            </Grid>
                                        </Grid>

                                        <Border Grid.Row="12"
                                                Background="#2FFFFFFF"
                                                BorderBrush="#66FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="20"
                                                Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="96" Height="96">
                                                    <Ellipse Width="72"
                                                             Height="72"
                                                             Stroke="#DCEFF0"
                                                             StrokeThickness="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>

                                                    <Path Data="{Binding CompletionArcData}"
                                                          Stroke="{Binding CompletionBrush}"
                                                          StrokeThickness="8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>

                                                    <Border Width="58"
                                                            Height="58"
                                                            CornerRadius="29"
                                                            Background="#EFFFFFFF"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>

                                                    <TextBlock Text="{Binding CompletionDisplay}"
                                                               FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="#111827"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="Percentage Completion"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#6B7280"/>

                                                    <TextBlock Text="{Binding CompletionDisplay}"
                                                               Margin="0,4,0,0"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding CompletionBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Button Grid.Row="14"
                                                Height="46"
                                                Background="#0EA5A8"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="{Binding EditToolTip}"
                                                Click="EditButton_Click">
                                            <Button.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.14"/>
                                            </Button.Effect>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Pencil"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Margin="0,0,8,0"
                                                                         Foreground="White"/>
                                                <TextBlock Text="Edit Contract" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>