<Window x:Class="RubexOps.EditProductionRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Edit Production Record"
        Height="820"
        Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7F8">

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <StackPanel Orientation="Horizontal">
            <Border Width="58"
                    Height="58"
                    CornerRadius="29"
                    Background="#E7F6F7">
                <materialDesign:PackIcon Kind="Pencil"
                                         Width="28"
                                         Height="28"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Edit Production Record"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Correct operational production values while preserving batch identity"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================= -->
        <!-- MAIN CARD -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="30">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#F9FAFB"
                            CornerRadius="16"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="18"
                            Margin="0,0,0,30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Batch ID" FontSize="12" Foreground="#6B7280"/>
                                <TextBlock x:Name="BatchIdText" FontSize="22" FontWeight="Bold" Foreground="#0B8A8F"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Remaining Quantity" FontSize="12" Foreground="#6B7280"/>
                                <TextBlock x:Name="RemainingText" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Loss / DRC Variance" FontSize="12" Foreground="#6B7280"/>
                                <TextBlock x:Name="LossVarianceText" FontSize="22" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Batch Source"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Production Date" Grid.Row="0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Supplier" Grid.Row="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Supplier ID" Grid.Row="2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Invoice Number" Grid.Row="3" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Quantity Available" Grid.Row="4" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <DatePicker x:Name="ProductionDatePicker" Grid.Row="0" Grid.Column="1" Height="46" FontSize="15"/>
                        <TextBox x:Name="SupplierNameBox" Grid.Row="1" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                        <TextBox x:Name="SupplierIDBox" Grid.Row="2" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                        <TextBox x:Name="InvoiceNumberBox" Grid.Row="3" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                        <TextBox x:Name="QuantityAvailableBox" Grid.Row="4" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                    </Grid>

                    <TextBlock Text="Material and Analytics"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0B8A8F"
                               Margin="0,34,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="66"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Raw Material" Grid.Row="0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Finished Product" Grid.Row="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Input / Output" Grid.Row="2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Initial / Actual DRC" Grid.Row="3" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Calculated Results" Grid.Row="4" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBox x:Name="RawMaterialBox" Grid.Row="0" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                        <TextBox x:Name="RawMaterialCodeBox" Grid.Row="0" Grid.Column="3" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>

                        <TextBox x:Name="FinishedProductBox" Grid.Row="1" Grid.Column="1" Height="46" FontSize="15" Padding="14,5"/>
                        <TextBox x:Name="FinishedProductCodeBox" Grid.Row="1" Grid.Column="3" Height="46" FontSize="15" Padding="14,5"/>

                        <TextBox x:Name="InputWeightBox" Grid.Row="2" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>
                        <TextBox x:Name="OutputWeightBox" Grid.Row="2" Grid.Column="3" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>

                        <TextBox x:Name="InitialDrcBox" Grid.Row="3" Grid.Column="1" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>
                        <TextBox x:Name="ActualDrcBox" Grid.Row="3" Grid.Column="3" Height="46" FontSize="15" Padding="14,5" TextChanged="CalculationInput_TextChanged"/>

                        <TextBox x:Name="CalculatedResultsBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Height="46" FontSize="15" Padding="14,5" IsReadOnly="True" Background="#F3F4F6"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================================================= -->
        <!-- ACTIONS -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="140"
                    Height="50"
                    Margin="0,0,16,0"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    FontSize="15"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Content="Save Changes"
                    Width="190"
                    Height="50"
                    Background="#0EA5A8"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

