<Page x:Class="RubexOps.PurchasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F4F7F8">

    <Grid>

        <!-- ================================================= -->
        <!-- LOADING OVERLAY -->
        <!-- ================================================= -->

        <Grid x:Name="LoadingOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="999">

            <Border Width="320"
                    Height="180"
                    Background="White"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- SPINNER -->

                    <ProgressBar Width="220"
                                 Height="18"
                                 IsIndeterminate="True"
                                 Foreground="#1B9AA0"/>

                    <!-- TEXT -->

                    <TextBlock Text="Loading..."
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1E2F35"
                               Margin="0,28,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Please wait while the page opens"
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>



        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <Grid Margin="35">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- PAGE HEADER -->

                <StackPanel Orientation="Horizontal">

                    <!-- ICON -->

                    <Border Width="65"
                            Height="65"
                            CornerRadius="32.5"
                            Background="#EAF7F7">

                        <materialDesign:PackIcon Kind="Cart"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="#0B7A81"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>


                    <!-- TITLE -->

                    <StackPanel Margin="18,0,0,0">

                        <TextBlock Text="Purchase"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="#1E2F35"/>

                        <Border Width="180"
                                Height="4"
                                Background="#F4A261"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>


                <!-- CONTENT AREA -->

                <Grid Grid.Row="1"
                      Margin="0,40,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- CONTRACT SECTION -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="18"
                            Padding="35"
                            BorderBrush="#E4E7E8"
                            BorderThickness="1">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- HEADER -->

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="FileDocumentEdit"
                                                         Width="40"
                                                         Height="40"
                                                         Foreground="#0B7A81"
                                                         Margin="0,0,18,0"/>

                                <StackPanel>

                                    <TextBlock Text="Contract Management"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#0B7A81"/>

                                    <TextBlock Text="Manage purchase contracts and renewals"
                                               FontSize="16"
                                               Margin="0,6,0,0"
                                               Foreground="#777"/>
                                </StackPanel>
                            </StackPanel>


                            <!-- BUTTONS -->

                            <StackPanel Grid.Row="1"
                                        Margin="0,40,0,0">

                                <Button x:Name="CreateContractButton"
                                        Content="Create Contract"
                                        Height="60"
                                        FontSize="17"
                                        Margin="0,0,0,18"
                                        Background="#1B9AA0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="CreateContractButton_Click"
                                        Cursor="Hand"/>

                                

                                <Button x:Name="ViewEditContractsButton"
                                        Content="View Contracts"
                                        Height="60"
                                        FontSize="17"
                                        Background="#1B9AA0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="ViewEditContractsButton_Click"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <!-- ================================================= -->
                    <!-- DATA MANAGEMENT -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="18"
                            Padding="35"
                            BorderBrush="#E4E7E8"
                            BorderThickness="1">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- HEADER -->

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="DatabaseEdit"
                                                         Width="40"
                                                         Height="40"
                                                         Foreground="#0B7A81"
                                                         Margin="0,0,18,0"/>

                                <StackPanel>

                                    <TextBlock Text="Data Management"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#0B7A81"/>

                                    <TextBlock Text="Manage purchase entries and records"
                                               FontSize="16"
                                               Margin="0,6,0,0"
                                               Foreground="#777"/>
                                </StackPanel>
                            </StackPanel>


                            <!-- BUTTONS -->

                            <StackPanel Grid.Row="1"
                                        Margin="0,40,0,0">

                                <Button Content="Enter Purchase Data"
                                        Height="60"
                                        FontSize="17"
                                        Margin="0,0,0,18"
                                        Background="#1B9AA0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="EnterPurchaseData_Click"
                                        Cursor="Hand"/>

                                <Button Content="View / Edit Purchase Data"
                                        Height="60"
                                        FontSize="17"
                                        Background="#1B9AA0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="ViewEditPurchaseData_Click"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>