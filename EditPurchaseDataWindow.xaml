<Window x:Class="RubexOps.EditPurchaseDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Edit Purchase Data"
        Width="900"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7F8">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="FormLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="RequiredStar"
               TargetType="TextBlock">
            <Setter Property="Text" Value="*"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Margin" Value="4,-4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="MainGrid"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="58"
                    Height="58"
                    CornerRadius="29"
                    Background="#E7F6F7">

                <materialDesign:PackIcon Kind="Pencil"
                                         Width="28"
                                         Height="28"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="Edit Purchase Data"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <Border Width="320"
                        Height="4"
                        Background="#F59E42"
                        CornerRadius="2"
                        Margin="0,7,0,0"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>



        <!-- ================================================= -->
        <!-- MAIN CARD -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="28">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>



                        <!-- ================================================= -->
                        <!-- VENDOR DETAILS -->
                        <!-- ================================================= -->

                        <TextBlock Text="Vendor Details"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,0,0,22"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Vendor Name"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Vendor ID"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <TextBlock Text="Item Code"
                                       Grid.Row="2"
                                       Style="{StaticResource FormLabel}"/>

                            <TextBox x:Name="VendorNameBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="VendorIDBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="ItemCodeBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Background="#F3F4F6"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>
                        </Grid>



                        <!-- ================================================= -->
                        <!-- PURCHASE DETAILS -->
                        <!-- ================================================= -->

                        <TextBlock Text="Purchase Details"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,34,0,22"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Invoice Number"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Purchase Order"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Delivery"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <TextBox x:Name="InvoiceNumberBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <DatePicker x:Name="PurchaseOrderDatePicker"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Height="50"
                                        FontSize="15"
                                        Padding="12,0"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1.5"/>

                            <DatePicker x:Name="DeliveryDatePicker"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Height="50"
                                        FontSize="15"
                                        Padding="12,0"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1.5"/>
                        </Grid>



                        <!-- ================================================= -->
                        <!-- WEIGHT DETAILS -->
                        <!-- ================================================= -->

                        <TextBlock Text="Weight Details"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,34,0,22"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Invoice Weight"
                                       Grid.Row="0"
                                       Style="{StaticResource FormLabel}"/>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Before Unloading"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Carrier Weight"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <TextBlock Text="No. of Bags"
                                       Grid.Row="3"
                                       Style="{StaticResource FormLabel}"/>

                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Calculated DRC (%)"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <TextBox x:Name="InvoiceWeightBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="BeforeUnloadingBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="CarrierWeightBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="NoOfBagsBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="CalculatedDrcBox"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>
                        </Grid>



                        <!-- ================================================= -->
                        <!-- TAX DETAILS -->
                        <!-- ================================================= -->

                        <TextBlock Text="Tax and Charge Details"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,34,0,22"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="70"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="GST (%)"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="TDS 194Q (%)"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Unloading Charge"
                                           Style="{StaticResource FormLabel}"/>
                                <TextBlock Style="{StaticResource RequiredStar}"/>
                            </StackPanel>

                            <TextBox x:Name="GstBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="Tds194QBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>

                            <TextBox x:Name="UnloadingChargeBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,5"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>



                <!-- ================================================= -->
                <!-- BUTTONS -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">

                    <Button Content="Cancel"
                            Width="140"
                            Height="50"
                            Margin="0,0,16,0"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cancel_Click"/>

                    <Button x:Name="SaveButton"
                            Content="Save Changes"
                            Width="180"
                            Height="50"
                            Background="#0EA5A8"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
