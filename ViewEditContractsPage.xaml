<Page x:Class="RubexOps.ViewEditContractsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <Grid>

        <Image Source="Images/Rubex_logo.png"
               Width="500"
               Height="500"
               Opacity="0.13"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="0"/>

        <Grid x:Name="MainGrid"
              Margin="24"
              Panel.ZIndex="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <Border Width="68"
                            Height="68"
                            CornerRadius="34"
                            Background="#AAFFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.12"/>
                        </Border.Effect>

                        <materialDesign:PackIcon Kind="FileDocumentMultiple"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#0B8A8F"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="18,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="View Contracts"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Manage and monitor purchase contract lifecycle"
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   Foreground="#6B7280"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Width="190"
                            Height="54"
                            Margin="0,0,14,0"
                            Background="#0EA5A8"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RenewContract_Click">

                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14"
                                              ShadowDepth="0"
                                              Opacity="0.18"/>
                        </Button.Effect>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <materialDesign:PackIcon Kind="Refresh"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,8,0"
                                                     Foreground="White"
                                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Renew Contract"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button>

                    <Border Padding="18,12"
                            CornerRadius="18"
                            Background="#88FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0.10"/>
                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Visible Contracts"
                                       FontSize="12"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="{Binding ElementName=ContractsItemsControl, Path=Items.Count}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <Border Grid.Row="2"
                    Background="#88FFFFFF"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.10"/>
                </Border.Effect>

                <WrapPanel VerticalAlignment="Center"
                           HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,22,0">

                        <Ellipse Width="12"
                                 Height="12"
                                 Fill="#10B981"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="Active"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,22,0">

                        <Ellipse Width="12"
                                 Height="12"
                                 Fill="#3B82F6"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="Upcoming"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,22,0">

                        <Ellipse Width="12"
                                 Height="12"
                                 Fill="#8B5CF6"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="Completed"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,22,0">

                        <Ellipse Width="12"
                                 Height="12"
                                 Fill="#EF4444"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="Violated"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="12"
                                 Height="12"
                                 Fill="#F59E0B"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="Expired"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </WrapPanel>

            </Border>

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1">

                    <Grid>

                        <TextBox x:Name="SearchBox"
                                 FontSize="15"
                                 Padding="46,0,18,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextChanged="SearchBox_TextChanged"/>

                        <materialDesign:PackIcon Kind="Magnify"
                                                 Width="22"
                                                 Height="22"
                                                 Margin="14,0,0,0"
                                                 Foreground="#6B7280"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>

                        <TextBlock Text="Search using Vendor ID or Name"
                                   Margin="46,0,0,0"
                                   FontSize="14"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                     Value="">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Border>

                <Border Grid.Column="2"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1">

                    <Grid>

                        <ComboBox x:Name="FilterComboBox"
                                  FontSize="15"
                                  Padding="44,0,12,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="FilterComboBox_SelectionChanged">

                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Upcoming"/>
                            <ComboBoxItem Content="Completed"/>
                            <ComboBoxItem Content="Violated"/>
                            <ComboBoxItem Content="Expired"/>

                        </ComboBox>

                        <materialDesign:PackIcon Kind="FilterVariant"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#6B7280"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Margin="14,0,0,0"
                                                 IsHitTestVisible="False"/>

                    </Grid>

                </Border>

                <Border Grid.Column="4"
                        Height="50"
                        CornerRadius="14"
                        Background="#88FFFFFF"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1">

                    <Grid>

                        <ComboBox x:Name="SortComboBox"
                                  FontSize="15"
                                  Padding="44,0,12,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="SortComboBox_SelectionChanged">

                            <ComboBoxItem Content="Name Ascending"/>
                            <ComboBoxItem Content="Name Descending"/>
                            <ComboBoxItem Content="Agreed Qty Ascending"/>
                            <ComboBoxItem Content="Agreed Qty Descending"/>

                        </ComboBox>

                        <materialDesign:PackIcon Kind="Sort"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#6B7280"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Margin="14,0,0,0"
                                                 IsHitTestVisible="False"/>

                    </Grid>

                </Border>

            </Grid>

            <ScrollViewer Grid.Row="6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="ContractsItemsControl">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,18,22"
                                    Background="#88FFFFFF"
                                    CornerRadius="26"
                                    Padding="22"
                                    BorderBrush="#99FFFFFF"
                                    BorderThickness="1"
                                    Opacity="{Binding CardOpacity}"
                                    MinWidth="300"
                                    HorizontalAlignment="Stretch">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28"
                                                      ShadowDepth="0"
                                                      Opacity="0.12"/>
                                </Border.Effect>

                                <Grid>

                                    <Border CornerRadius="22"
                                            Background="#20FFFFFF"
                                            Margin="-8"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding vendor_name}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,12,0"/>

                                            <Border Grid.Column="1"
                                                    Padding="12,6"
                                                    CornerRadius="12"
                                                    Background="{Binding StatusBackground}"
                                                    VerticalAlignment="Top">

                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="13"/>

                                            </Border>

                                        </Grid>

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Contract ID"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ContractIdDisplay}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>

                                            </Grid>

                                            <Grid Grid.Column="2">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Item Code"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ItemCodeDisplay}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>

                                            </Grid>

                                        </Grid>

                                        <Grid Grid.Row="4">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Start Date"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding start_date}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="End Date"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding end_date}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                        </Grid>

                                        <Grid Grid.Row="6">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Days Remaining"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DaysRemainingDisplay}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Agreed Qty"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding AgreedQtyDisplay}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                        </Grid>

                                        <Grid Grid.Row="8">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Base Price"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding BasePriceDisplay}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Deliveries"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DeliveriesSoFarDisplay}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                        </Grid>

                                        <Grid Grid.Row="10">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Qty Delivered So Far"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding QtyDeliveredSoFarDisplay}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Remaining"
                                                           FontSize="12"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding RemainingQtyDisplay}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                        </Grid>

                                        <Border Grid.Row="12"
                                                Background="#20FFFFFF"
                                                BorderBrush="#55FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="14">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Percentage Completion"
                                                           FontSize="12"
                                                           Foreground="#6B7280"
                                                           HorizontalAlignment="Center"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding CompletionDisplay}"
                                                           Margin="0,4,0,0"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Foreground="#111827"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                        </Border>

                                        <Button Grid.Row="14"
                                                Height="46"
                                                Background="#0EA5A8"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="{Binding EditToolTip}"
                                                Click="EditButton_Click">

                                            <Button.Effect>
                                                <DropShadowEffect BlurRadius="10"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.14"/>
                                            </Button.Effect>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <materialDesign:PackIcon Kind="Pencil"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Margin="0,0,8,0"
                                                                         Foreground="White"/>

                                                <TextBlock Text="Edit Contract"
                                                           FontWeight="Bold"/>

                                            </StackPanel>

                                        </Button>

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>

</Page>