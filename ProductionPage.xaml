<Page x:Class="RubexOps.ProductionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F7F8">

    <Page.Resources>

        <Style x:Key="ProductionActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="76"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="Background"
                    Value="#1B9AA0"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#16919A"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#127A81"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <!-- ================================================= -->
        <!-- MAIN CONTAINER -->
        <!-- ================================================= -->

        <Grid Margin="35">

            <!-- ================================================= -->
            <!-- WATERMARK -->
            <!-- ================================================= -->

            <Image Source="Images/Rubex_logo.png"
                   Width="500"
                   Height="500"
                   Opacity="0.15"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Panel.ZIndex="0"/>

            <!-- ================================================= -->
            <!-- MAIN CONTENT -->
            <!-- ================================================= -->

            <Grid Panel.ZIndex="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <StackPanel Orientation="Horizontal">

                    <Border Width="80"
                            Height="80"
                            CornerRadius="40"
                            Background="#AAFFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.12"/>
                        </Border.Effect>

                        <materialDesign:PackIcon Kind="Factory"
                                                 Width="36"
                                                 Height="36"
                                                 Foreground="#0B8A8F"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="22,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Production"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <Border Width="260"
                                Height="4"
                                Background="#F59E42"
                                CornerRadius="2"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ================================================= -->
                <!-- MODULE CARDS -->
                <!-- ================================================= -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================================================= -->
                    <!-- PRODUCTION ENTRY CARD -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
                            CornerRadius="28"
                            Padding="44"
                            Background="#88FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30"
                                              ShadowDepth="0"
                                              Opacity="0.16"/>
                        </Border.Effect>

                        <Grid>

                            <!-- INNER LIGHT LAYER -->

                            <Border CornerRadius="24"
                                    Background="#30FFFFFF"
                                    Margin="-18"/>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="72"
                                            Height="72"
                                            CornerRadius="22"
                                            Background="#55FFFFFF"
                                            BorderBrush="#90FFFFFF"
                                            BorderThickness="1"
                                            Margin="0,0,22,0">

                                        <materialDesign:PackIcon Kind="ClipboardPlus"
                                                                 Width="34"
                                                                 Height="34"
                                                                 Foreground="#0B8A8F"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel>

                                        <TextBlock Text="Production Entry"
                                                   FontSize="34"
                                                   FontWeight="Bold"
                                                   Foreground="#0B8A8F"/>

                                        <TextBlock Text="Add production batches and operational records"
                                                   FontSize="16"
                                                   Foreground="#6B7280"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- DESCRIPTION -->

                                <TextBlock Grid.Row="2"
                                           Text="Create and manage daily production entries including batch tracking, DRC analysis, production loss monitoring, and operational data management."
                                           FontSize="20"
                                           LineHeight="38"
                                           TextWrapping="Wrap"
                                           Foreground="#374151"/>

                                <!-- BUTTON -->

                                <Button Grid.Row="4"
                                        Content="Enter Production Data"
                                        Click="EnterProductionDataButton_Click"
                                        Style="{StaticResource ProductionActionButtonStyle}"
                                        Foreground="White"
                                        Background="#1B9AA0">

                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0.20"/>
                                    </Button.Effect>
                                </Button>

                            </Grid>

                        </Grid>
                    </Border>

                    <!-- ================================================= -->
                    <!-- PRODUCTION RECORDS CARD -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2"
                            CornerRadius="28"
                            Padding="44"
                            Background="#88FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30"
                                              ShadowDepth="0"
                                              Opacity="0.16"/>
                        </Border.Effect>

                        <Grid>

                            <!-- INNER LIGHT LAYER -->

                            <Border CornerRadius="24"
                                    Background="#30FFFFFF"
                                    Margin="-18"/>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="72"
                                            Height="72"
                                            CornerRadius="22"
                                            Background="#55FFFFFF"
                                            BorderBrush="#90FFFFFF"
                                            BorderThickness="1"
                                            Margin="0,0,22,0">

                                        <materialDesign:PackIcon Kind="DatabaseSearch"
                                                                 Width="34"
                                                                 Height="34"
                                                                 Foreground="#0B8A8F"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel>

                                        <TextBlock Text="Production Records"
                                                   FontSize="34"
                                                   FontWeight="Bold"
                                                   Foreground="#0B8A8F"/>

                                        <TextBlock Text="View and manage production history"
                                                   FontSize="16"
                                                   Foreground="#6B7280"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- DESCRIPTION -->

                                <TextBlock Grid.Row="2"
                                           Text="Filter, review, edit, and analyze existing production records, batch information, DRC variance, and operational history."
                                           FontSize="20"
                                           LineHeight="38"
                                           TextWrapping="Wrap"
                                           Foreground="#374151"/>

                                <!-- BUTTON -->

                                <Button Grid.Row="4"
                                        Content="View / Edit Production Data"
                                        Click="ViewEditProductionDataButton_Click"
                                        Style="{StaticResource ProductionActionButtonStyle}"
                                        Foreground="White"
                                        Background="#1B9AA0">

                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0.20"/>
                                    </Button.Effect>
                                </Button>

                            </Grid>

                        </Grid>
                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>