<Page x:Class="RubexOps.ProductionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F7F8">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <StackPanel Orientation="Horizontal">
            <Border Width="80"
                    Height="80"
                    CornerRadius="40"
                    Background="#E7F6F7">
                <materialDesign:PackIcon Kind="Factory"
                                         Width="36"
                                         Height="36"
                                         Foreground="#0B8A8F"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Production"
                           FontSize="46"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <Border Width="260"
                        Height="4"
                        Background="#F59E42"
                        CornerRadius="2"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================= -->
        <!-- MODULE CARDS -->
        <!-- ================================================= -->

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="44">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardPlus"
                                                 Width="42"
                                                 Height="42"
                                                 Foreground="#0B8A8F"
                                                 Margin="0,0,22,0"/>
                        <StackPanel>
                            <TextBlock Text="Production Entry"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"/>
                            <TextBlock Text="Add production batches and operational records"
                                       FontSize="16"
                                       Foreground="#6B7280"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="Create and manage daily production entries including batch tracking, DRC analysis, production loss monitoring, and operational data management."
                               FontSize="20"
                               LineHeight="38"
                               TextWrapping="Wrap"
                               Foreground="#374151"/>

                    <Button Grid.Row="4"
                            Content="Enter Production Data"
                            Height="76"
                            Background="#1B9AA0"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="EnterProductionData_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="44">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseSearch"
                                                 Width="42"
                                                 Height="42"
                                                 Foreground="#0B8A8F"
                                                 Margin="0,0,22,0"/>
                        <StackPanel>
                            <TextBlock Text="Production Records"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#0B8A8F"/>
                            <TextBlock Text="View and manage production history"
                                       FontSize="16"
                                       Foreground="#6B7280"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="Filter, review, edit, and analyze existing production records, batch information, DRC variance, and operational history."
                               FontSize="20"
                               LineHeight="38"
                               TextWrapping="Wrap"
                               Foreground="#374151"/>

                    <Button Grid.Row="4"
                            Content="View / Edit Production Data"
                            Height="76"
                            Background="#1B9AA0"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="ViewEditProductionData_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

