<Page x:Class="RubexOps.ViewEditProductionDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#F5F7F8">

    <!-- ================================================= -->
    <!-- ROOT GRID -->
    <!-- ================================================= -->

    <Grid>

        <!-- ================================================= -->
        <!-- FIXED WATERMARK -->
        <!-- ================================================= -->

        <Image Source="Images/Rubex_logo.png"
               Width="500"
               Height="500"
               Opacity="0.1"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="0"/>



        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <Grid x:Name="MainGrid"
              Margin="24"
              Panel.ZIndex="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>



                <!-- LEFT HEADER -->

                <StackPanel Orientation="Horizontal">

                    <Border Width="68"
                            Height="68"
                            CornerRadius="34"
                            Background="#AAFFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0.14"/>
                        </Border.Effect>

                        <materialDesign:PackIcon Kind="DatabaseSearch"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#0B8A8F"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>



                    <StackPanel Margin="18,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="View / Edit Production Data"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Operational production dashboard, batch history and manufacturing analytics"
                                   FontSize="15"
                                   Foreground="#6B7280"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </StackPanel>



                <!-- REFRESH BUTTON -->

                <Button Grid.Column="1"
                        Width="58"
                        Height="58"
                        Background="#0EA5A8"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Refresh production records"
                        Click="RefreshButton_Click">

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="14"
                                          ShadowDepth="0"
                                          Opacity="0.18"/>
                    </Button.Effect>

                    <materialDesign:PackIcon Kind="Refresh"
                                             Width="24"
                                             Height="24"
                                             Foreground="White"/>
                </Button>

            </Grid>



            <!-- ================================================= -->
            <!-- ANALYTICS PANELS -->
            <!-- ================================================= -->

            <UniformGrid Grid.Row="2"
                         Columns="6">

                <!-- CARD 1 -->

                <Border Background="#88FFFFFF"
                        CornerRadius="18"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Total Production Today"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="TodayOutputText"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0B8A8F"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>



                <!-- CARD 2 -->

                <Border Background="#88FFFFFF"
                        CornerRadius="18"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Total Output"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="TotalOutputText"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>



                <!-- CARD 3 -->

                <Border Background="#88FFFFFF"
                        CornerRadius="18"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Total Loss"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="TotalLossText"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#EF4444"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>



                <!-- CARD 4 -->

                <Border Background="#88FFFFFF"
                        CornerRadius="18"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Avg DRC Variance"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="AverageVarianceText"
                                   Text="0%"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>



                <!-- CARD 5 -->

                <Border Background="#88FFFFFF"
                        CornerRadius="18"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,12,0">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Active Batches"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="ActiveBatchesText"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>



                <!-- CARD 6 -->

                <Border Background="#88FFFFFF"
                        CornerRadius="18"
                        BorderBrush="#99FFFFFF"
                        BorderThickness="1"
                        Padding="16">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Highest Loss Batch"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="HighestLossBatchText"
                                   Text="-"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>



            <!-- ================================================= -->
            <!-- FILTER BAR -->
            <!-- ================================================= -->

            <Border Grid.Row="4"
                    Background="#88FFFFFF"
                    CornerRadius="22"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1"
                    Padding="18">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.10"/>
                </Border.Effect>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>



                    <!-- SEARCH -->

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Height="48"
                             FontSize="14"
                             Padding="14,5"
                             VerticalContentAlignment="Center"
                             Background="#70FFFFFF"
                             BorderBrush="#99FFFFFF"
                             BorderThickness="1"
                             ToolTip="Search batch, supplier, invoice, raw material, or product"
                             TextChanged="FilterChanged"/>



                    <!-- FILTERS -->

                    <TextBox x:Name="SupplierFilterBox"
                             Grid.Column="2"
                             Height="48"
                             FontSize="14"
                             Padding="14,5"
                             VerticalContentAlignment="Center"
                             Background="#70FFFFFF"
                             BorderBrush="#99FFFFFF"
                             BorderThickness="1"
                             ToolTip="Supplier filter"
                             TextChanged="FilterChanged"/>

                    <TextBox x:Name="MaterialFilterBox"
                             Grid.Column="4"
                             Height="48"
                             FontSize="14"
                             Padding="14,5"
                             VerticalContentAlignment="Center"
                             Background="#70FFFFFF"
                             BorderBrush="#99FFFFFF"
                             BorderThickness="1"
                             ToolTip="Raw material filter"
                             TextChanged="FilterChanged"/>

                    <TextBox x:Name="ProductFilterBox"
                             Grid.Column="6"
                             Height="48"
                             FontSize="14"
                             Padding="14,5"
                             VerticalContentAlignment="Center"
                             Background="#70FFFFFF"
                             BorderBrush="#99FFFFFF"
                             BorderThickness="1"
                             ToolTip="Finished product filter"
                             TextChanged="FilterChanged"/>



                    <!-- DATE PICKERS -->

                    <Border Grid.Column="8"
                            Background="#70FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">

                        <DatePicker x:Name="FromDatePicker"
                                    Height="48"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    SelectedDateChanged="DateFilterChanged"/>
                    </Border>



                    <Border Grid.Column="10"
                            Background="#70FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">

                        <DatePicker x:Name="ToDatePicker"
                                    Height="48"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    SelectedDateChanged="DateFilterChanged"/>
                    </Border>



                    <!-- SORT -->

                    <Border Grid.Column="12"
                            Background="#70FFFFFF"
                            BorderBrush="#99FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">

                        <ComboBox x:Name="SortComboBox"
                                  Height="48"
                                  FontSize="14"
                                  Padding="12,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionChanged="SortComboBox_SelectionChanged">

                            <ComboBoxItem Content="Production Date Newest"/>
                            <ComboBoxItem Content="Production Date Oldest"/>
                            <ComboBoxItem Content="Batch ID Ascending"/>
                            <ComboBoxItem Content="Batch ID Descending"/>
                            <ComboBoxItem Content="Loss High to Low"/>
                            <ComboBoxItem Content="DRC Variance High to Low"/>
                            <ComboBoxItem Content="Output High to Low"/>

                        </ComboBox>
                    </Border>

                </Grid>

            </Border>



            <!-- ================================================= -->
            <!-- TABLE CONTAINER -->
            <!-- ================================================= -->

            <Border Grid.Row="6"
                    Background="#88FFFFFF"
                    CornerRadius="24"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1"
                    Padding="10">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="35"
                                      ShadowDepth="0"
                                      Opacity="0.12"/>
                </Border.Effect>



                <!-- DATA GRID -->

                <DataGrid x:Name="ProductionDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          FontSize="14"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionChanged="ProductionDataGrid_SelectionChanged">

                    <!-- ROW STYLE -->

                    <DataGrid.RowStyle>

                        <Style TargetType="DataGridRow">

                            <Setter Property="Background"
                                    Value="#40FFFFFF"/>

                            <Setter Property="MinHeight"
                                    Value="42"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding is_high_loss}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="#55FEF2F2"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding is_high_drc_variance}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="#55FFFBEB"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </DataGrid.RowStyle>



                    <!-- COLUMN HEADER STYLE -->

                    <DataGrid.ColumnHeaderStyle>

                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="#50FFFFFF"/>

                            <Setter Property="Foreground"
                                    Value="#111827"/>

                            <Setter Property="FontWeight"
                                    Value="Bold"/>

                            <Setter Property="Height"
                                    Value="48"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>
                        </Style>

                    </DataGrid.ColumnHeaderStyle>



                    <!-- COLUMNS -->

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header=""
                                                Width="62">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Width="38"
                                            Height="34"
                                            Background="#0EA5A8"
                                            BorderThickness="0"
                                            Click="EditButton_Click"
                                            ToolTip="Edit production record">

                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="10"
                                                              ShadowDepth="0"
                                                              Opacity="0.15"/>
                                        </Button.Effect>

                                        <materialDesign:PackIcon Kind="Pencil"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Foreground="White"/>
                                    </Button>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>



                        <DataGridTextColumn Header="Batch ID"
                                            Binding="{Binding batch_id}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Production Date"
                                            Binding="{Binding production_date}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Supplier"
                                            Binding="{Binding supplier_name}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Invoice"
                                            Binding="{Binding invoice_number}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Raw Material"
                                            Binding="{Binding raw_material}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Finished Product"
                                            Binding="{Binding finished_product}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Input"
                                            Binding="{Binding InputDisplay}"
                                            Width="95"/>

                        <DataGridTextColumn Header="Output"
                                            Binding="{Binding OutputDisplay}"
                                            Width="95"/>

                        <DataGridTextColumn Header="Loss"
                                            Binding="{Binding LossDisplay}"
                                            Width="95"/>

                        <DataGridTextColumn Header="DRC Var."
                                            Binding="{Binding VarianceDisplay}"
                                            Width="95"/>

                    </DataGrid.Columns>



                    <!-- ROW DETAILS -->

                    <DataGrid.RowDetailsTemplate>

                        <DataTemplate>

                            <Border Background="#50FFFFFF"
                                    BorderBrush="#99FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16"
                                    Margin="8,4,8,12">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>



                                    <StackPanel>

                                        <TextBlock Text="Supplier ID"
                                                   FontSize="12"
                                                   Foreground="#6B7280"/>

                                        <TextBlock Text="{Binding supplier_id}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>



                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Raw Code"
                                                   FontSize="12"
                                                   Foreground="#6B7280"/>

                                        <TextBlock Text="{Binding raw_material_code}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>



                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="Product Code"
                                                   FontSize="12"
                                                   Foreground="#6B7280"/>

                                        <TextBlock Text="{Binding finished_product_code}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>



                                    <StackPanel Grid.Column="3">

                                        <TextBlock Text="Available / Remaining"
                                                   FontSize="12"
                                                   Foreground="#6B7280"/>

                                        <TextBlock Text="{Binding AvailabilityDisplay}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>



                                    <StackPanel Grid.Column="4">

                                        <TextBlock Text="Initial / Actual DRC"
                                                   FontSize="12"
                                                   Foreground="#6B7280"/>

                                        <TextBlock Text="{Binding DrcDisplay}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </DataGrid.RowDetailsTemplate>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Page>